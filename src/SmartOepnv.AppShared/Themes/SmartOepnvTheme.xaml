<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Smart-ÖPNV Planer: Dunkelblau (Material Blue 900 / 800) -->
    <Color x:Key="SmartPrimaryColor">#FF0D47A1</Color>
    <Color x:Key="SmartPrimaryDarkColor">#FF002171</Color>
    <Color x:Key="SmartPrimaryLightColor">#FF5472D3</Color>
    <Color x:Key="SmartAccentColor">#FF42A5F5</Color>
    <Color x:Key="SmartSurfaceColor">#FF121A2E</Color>
    <Color x:Key="SmartBackgroundColor">#FF0A1020</Color>

    <SolidColorBrush x:Key="SmartPrimaryBrush" Color="{StaticResource SmartPrimaryColor}" />
    <SolidColorBrush x:Key="SmartPrimaryDarkBrush" Color="{StaticResource SmartPrimaryDarkColor}" />
    <SolidColorBrush x:Key="SmartPrimaryLightBrush" Color="{StaticResource SmartPrimaryLightColor}" />
    <SolidColorBrush x:Key="SmartAccentBrush" Color="{StaticResource SmartAccentColor}" />
    <SolidColorBrush x:Key="SmartSurfaceBrush" Color="{StaticResource SmartSurfaceColor}" />
    <SolidColorBrush x:Key="SmartBackgroundBrush" Color="{StaticResource SmartBackgroundColor}" />

    <Color x:Key="SmartSuccessColor">#FF66BB6A</Color>
    <Color x:Key="SmartSuccessBackgroundColor">#264CAF50</Color>
    <Color x:Key="SmartSuccessBorderColor">#664CAF50</Color>
    <Color x:Key="SmartSuccessOnDarkColor">#FF81C784</Color>
    <Color x:Key="SmartSuccessOnDarkBackgroundColor">#4081C784</Color>
    <Color x:Key="SmartSuccessOnDarkBorderColor">#8081C784</Color>

    <SolidColorBrush x:Key="SmartSuccessForegroundBrush" Color="{StaticResource SmartSuccessColor}" />
    <SolidColorBrush x:Key="SmartSuccessBackgroundBrush" Color="{StaticResource SmartSuccessBackgroundColor}" />
    <SolidColorBrush x:Key="SmartSuccessBorderBrush" Color="{StaticResource SmartSuccessBorderColor}" />
    <SolidColorBrush x:Key="SmartSuccessOnDarkForegroundBrush" Color="{StaticResource SmartSuccessOnDarkColor}" />
    <SolidColorBrush x:Key="SmartSuccessOnDarkBackgroundBrush" Color="{StaticResource SmartSuccessOnDarkBackgroundColor}" />
    <SolidColorBrush x:Key="SmartSuccessOnDarkBorderBrush" Color="{StaticResource SmartSuccessOnDarkBorderColor}" />

    <Style x:Key="SmartPageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SmartPageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>

</ResourceDictionary>
