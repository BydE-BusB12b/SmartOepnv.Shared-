<Window x:Class="SmartOepnv.AppShared.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding ProductName}"
        Height="900" Width="1440"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="Manual"
        Background="{StaticResource SmartBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- App-Bar -->
            <materialDesign:ColorZone Grid.Row="0"
                                      Mode="PrimaryDark"
                                      Padding="16,12"
                                      materialDesign:ElevationAssist.Elevation="Dp4">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="BusArticulatedFront"
                                                 Width="36" Height="36"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProductName}"
                                       FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProductSubtitle}"
                                       FontSize="12" Opacity="0.85" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}"
                                ToolTip="Einstellungen"
                                Command="{Binding OpenSettingsCommand}">
                            <materialDesign:PackIcon Kind="Cog" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </materialDesign:ColorZone>

            <!-- Hauptbereich mit Navigation -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0"
                                     Margin="12"
                                     Padding="0"
                                     UniformCornerRadius="12"
                                     Background="{StaticResource SmartSurfaceBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Navigation"
                                   Margin="20,20,20,8"
                                   FontWeight="SemiBold"
                                   Opacity="0.7" />
                        <ListBox ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Margin="8,0,8,12">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                 Width="22" Height="22"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,14,0"
                                                                 Foreground="{StaticResource SmartAccentBrush}" />
                                        <TextBlock Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   FontSize="15" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Width="20" Height="20"
                                                CornerRadius="10"
                                                Background="#FBC02D"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BadgeText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding BadgeText}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       Foreground="#1B1B1B" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="1"
                                     Margin="0,12,12,12"
                                     Padding="16"
                                     UniformCornerRadius="12"
                                     Background="{StaticResource SmartSurfaceBrush}"
                                     ClipToBounds="True">
                    <Grid ClipToBounds="True">
                        <ContentControl Content="{Binding CurrentPage}"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch" />
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- Statusleiste -->
            <Border Grid.Row="2"
                    Background="{StaticResource SmartPrimaryDarkBrush}"
                    Padding="16,8">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Opacity="0.9" />
                    <TextBlock DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Opacity="0.65">
                        <Run Text="v" />
                        <Run Text="{Binding AppVersion}" />
                        <Run Text=" · Smart-ÖPNV" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>
