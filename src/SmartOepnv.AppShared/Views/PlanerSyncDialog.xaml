<Window x:Class="SmartOepnv.AppShared.Views.PlanerSyncDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartOepnv.AppShared.Views"
        Title="Smart-ÖPNV Planer"
        Width="580"
        MinWidth="540"
        MinHeight="220"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF0A1020"
        Foreground="White">

    <Border Margin="16"
            Padding="28,24"
            CornerRadius="12"
            Background="#FF121A2E">
        <StackPanel>
            <TextBlock Text="Wir synchronisieren kurz."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,6" />
            <TextBlock Text="Arbeitsstand wird mit Dropbox abgeglichen…"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="12"
                       Opacity="0.75"
                       Foreground="White"
                       Margin="0,0,0,20" />

            <views:PlanerSyncBusAnimation x:Name="BusAnimation" />
        </StackPanel>
    </Border>
</Window>
