<UserControl x:Class="SmartOepnv.AppShared.Views.RoutePathEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:SmartOepnv.AppShared.ViewModels"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             Margin="0">
    <UserControl.Resources>
        <!-- Gedämpfte Zustandsfarben (Outlined wie die übrigen Buttons, kein greller Vollton) -->
        <Storyboard x:Key="RoutePathSaveBlinkStoryboard" RepeatBehavior="Forever">
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(Panel.Background).(SolidColorBrush.Color)"
                                          Duration="0:0:0.55"
                                          AutoReverse="True">
                <LinearColorKeyFrame Value="#33FFB74D" KeyTime="0:0:0" />
                <LinearColorKeyFrame Value="#33FF9800" KeyTime="0:0:0.55" />
            </ColorAnimationUsingKeyFrames>
        </Storyboard>
        <Style x:Key="RoutePathSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Foreground" Value="{StaticResource SmartAccentBrush}" />
            <Setter Property="Background" Value="#2642A5F5" />
            <Setter Property="BorderBrush" Value="#6642A5F5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SaveButtonState}" Value="{x:Static vm:RoutePathSaveButtonState.Saved}">
                    <Setter Property="Foreground" Value="{StaticResource SmartSuccessOnDarkForegroundBrush}" />
                    <Setter Property="Background" Value="{StaticResource SmartSuccessOnDarkBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SmartSuccessOnDarkBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SaveButtonState}" Value="{x:Static vm:RoutePathSaveButtonState.Unsaved}">
                    <Setter Property="Foreground" Value="{StaticResource SmartAccentBrush}" />
                    <Setter Property="Background" Value="#2642A5F5" />
                    <Setter Property="BorderBrush" Value="#6642A5F5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SaveButtonState}" Value="{x:Static vm:RoutePathSaveButtonState.Saving}">
                    <Setter Property="Foreground" Value="#FFFFCC80" />
                    <Setter Property="Background" Value="#33FFB74D" />
                    <Setter Property="BorderBrush" Value="#80FFB74D" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="RoutePathSaveBlink" Storyboard="{StaticResource RoutePathSaveBlinkStoryboard}" />
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="RoutePathSaveBlink" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="RoutePathRoutePickerToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <Path HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="White" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SmartPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="RoutePathRoutePickerComboTemplate" TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True" HorizontalAlignment="Stretch">
                <ToggleButton x:Name="ToggleButton"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Foreground="{TemplateBinding Foreground}"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              Padding="{TemplateBinding Padding}"
                              Template="{StaticResource RoutePathRoutePickerToggleTemplate}" />
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       PopupAnimation="Slide"
                       Focusable="False">
                    <Grid MinWidth="280"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <Border Background="{StaticResource SmartPrimaryDarkBrush}"
                                BorderBrush="{StaticResource SmartAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="0,0,2,2" />
                        <ScrollViewer Margin="1"
                                      SnapsToDevicePixels="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Visible"
                                      CanContentScroll="False">
                            <ScrollViewer.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SmartDarkComboBoxScrollBar}" />
                            </ScrollViewer.Resources>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="PART_Popup" Property="MinHeight" Value="32" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="RoutePathRoutePickerCombo" TargetType="ComboBox" BasedOn="{StaticResource SmartDarkComboBox}">
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Template" Value="{StaticResource RoutePathRoutePickerComboTemplate}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   ToolTip="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoutePathLineColorCombo" TargetType="ComboBox" BasedOn="{StaticResource SmartDarkComboBox}">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type vm:RouteLineColorOption}">
                        <TextBlock Text="{Binding Label}"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Label}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <DockPanel x:Name="RootDock" LastChildFill="True" ClipToBounds="True">
        <!-- Rechts: feste Breite, scrollt bei wenig Fensterhöhe (treibt Layout-Höhe nicht auf) -->
        <ScrollViewer x:Name="RightPanelScrollViewer"
                      DockPanel.Dock="Right"
                      Width="400"
                      MaxWidth="440"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalAlignment="Stretch">
            <StackPanel MinWidth="360">
                <materialDesign:Card Padding="14" UniformCornerRadius="12"
                                     Background="{StaticResource SmartSurfaceBrush}"
                                     Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Route &amp; Fahrweg" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />

                        <TextBlock Text="Route" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      Style="{StaticResource RoutePathRoutePickerCombo}"
                                      ItemsSource="{Binding AvailableRoutes}"
                                      SelectedItem="{Binding SelectedRoute}"
                                      ToolTip="Route wechseln" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedRoute, TargetNullValue='— Route wählen —'}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SmartPrimaryBrush}"
                                       ToolTip="{Binding SelectedRoute}" />
                        </Grid>

                        <Button Content="Haltestellen laden"
                                Command="{Binding LoadStopsOnMapCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <Button Content="Straße snappen (Auswahl)"
                                Command="{Binding SnapSelectedSegmentCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                ToolTip="Nur die gewählte Verbindung (2 Punkte) – wie „Straße snappen“ am Handy." />
                        <Button Content="Alle Verbindungen snappen"
                                Command="{Binding SnapAllCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <Button Content="Alle Haltestellen verbinden"
                                Command="{Binding AutoBuildRouteCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch"
                                ToolTip="Verbindet alle Haltestellen auf einmal (ohne Snap) – für Punkt-zu-Punkt lieber A→B auf der Karte." />
                        <Button Content="Speichern"
                                Command="{Binding SaveToPackageCommand}"
                                Style="{StaticResource RoutePathSaveButtonStyle}"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Stretch"
                                ToolTip="Hellblau = ungespeichert, sanft orange blinkend = speichert, grün = gespeichert" />

                        <TextBlock Text="Fahrweg bearbeiten" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Button Content="Schritt zurück"
                                Command="{Binding UndoLastChangeCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <Button Content="Verbindung löschen"
                                Command="{Binding DeleteSelectedSegmentCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <Button Content="Fahrweg zurücksetzen"
                                Command="{Binding ResetRouteConnectionsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <Button Content="Nur Straßen-Snap löschen"
                                Command="{Binding ClearSnapOnlyCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                        <Button Content="Busspur / direkt (ohne PKW-Umweg)"
                                Command="{Binding ApplyBusStraightLaneCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,0,10" HorizontalAlignment="Stretch"
                                ToolTip="Gerade Linie A→B für Bussonderstreifen oder PKW-gesperrte Bereiche; OSRM-PKW-Routing wird umgangen." />

                        <TextBlock Text="Linienfarbe" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource RoutePathLineColorCombo}"
                                  ItemsSource="{Binding RouteLineColorOptions}"
                                  SelectedValuePath="Hex"
                                  SelectedValue="{Binding SelectedRouteLineColor}"
                                  Margin="0,0,0,10" />

                        <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   Opacity="0.85"
                                   FontSize="12" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="12" UniformCornerRadius="12"
                                     Background="{StaticResource SmartPrimaryDarkBrush}"
                                     Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Bedienung Karte"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Foreground="#BBDEFB"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   LineHeight="18">
                            <Run Text="• Haltestellen laden = nur Knoten (keine Auto-Linien)" />
                            <LineBreak />
                            <Run Text="• Knoten A tippen, dann B → gelbe Linie → Straße snappen / Busspur" />
                            <LineBreak />
                            <Run Text="• Gelb = bearbeitbar · Blau = gesnappt · Orange = Busspur" />
                            <LineBreak />
                            <Run Text="• Snap/Busspur-Button nur für gelbe Verbindungen" />
                            <LineBreak />
                            <Run Text="• Doppelklick auf Linie = Navi-Symbol setzen" />
                            <LineBreak />
                            <Run Text="• Orange gestrichelt = Busspur/direkt (ohne PKW-Umweg)" />
                            <LineBreak />
                            <Run Text="• Shift + Klick auf Linie = Zwischenpunkt" />
                            <LineBreak />
                            <Run Text="• Marker ziehen = Position ändern" />
                            <LineBreak />
                            <Run Text="• Rechtsklick auf Karte = manueller Wegpunkt" />
                            <LineBreak />
                            <Run Text="• „Schritt zurück“ oder „Fahrweg zurücksetzen“ rechts" />
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="14" UniformCornerRadius="12"
                                     Background="{StaticResource SmartPrimaryDarkBrush}">
                    <StackPanel>
                        <TextBlock Text="Navi-Symbol bearbeiten"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Hinweis auswählen"
                                   Foreground="#BBDEFB"
                                   FontSize="12"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Noch keine Navi-Hinweise auf der Route (nach Snap oder Doppelklick auf Linie)."
                                   Foreground="#90CAF9"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNavManeuvers}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="NavManeuverListBox"
                                 ItemsSource="{Binding NavManeuverItems}"
                                 SelectedItem="{Binding SelectedNavManeuverItem}"
                                 MaxHeight="200"
                                 Margin="0,0,0,10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNavManeuvers}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,0">
                                        <Image Source="{Binding IconUri}"
                                               Width="32" Height="32"
                                               Margin="0,0,10,0"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       Opacity="0.85"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Symboltyp"
                                   Foreground="#BBDEFB"
                                   FontSize="12"
                                   Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource SmartDarkComboBox}"
                                  ItemsSource="{Binding NavSymbolPickerOptions}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedNavSymbol}"
                                  MaxDropDownHeight="420"
                                  HorizontalAlignment="Stretch"
                                  MinWidth="320"
                                  Margin="0,0,0,8">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding IconUri}"
                                               Width="28" Height="28"
                                               Margin="0,0,8,0"
                                               Stretch="Uniform" />
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox materialDesign:HintAssist.Hint="Anweisungstext"
                                 Text="{Binding SelectedManeuverText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />
                        <Button Content="Symbol übernehmen"
                                Command="{Binding ApplyNavSymbolCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="White"
                                BorderBrush="#6642A5F5"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Stretch" />
                        <Button Content="Symbol löschen"
                                Command="{Binding DeleteNavSymbolCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#FFCDD2"
                                BorderBrush="#66EF5350"
                                HorizontalAlignment="Stretch"
                                ToolTip="Entfernt nur den gewählten Navi-Hinweis (nicht die ganze Verbindung)." />
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Links: Karte füllt verbleibende Breite und exakt die verfügbare Höhe -->
        <materialDesign:Card Padding="0"
                             UniformCornerRadius="12"
                             Background="{StaticResource SmartSurfaceBrush}"
                             Margin="0,0,10,0"
                             VerticalAlignment="Stretch"
                             ClipToBounds="True">
            <Grid ClipToBounds="True">
                <wv2:WebView2 x:Name="MapWebView"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch" />
            </Grid>
        </materialDesign:Card>
    </DockPanel>
</UserControl>
