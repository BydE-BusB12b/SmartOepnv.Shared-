<Window x:Class="SmartOepnv.AppShared.Views.DropboxOAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Dropbox verbinden"
        Height="720" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource SmartPrimaryDarkBrush}" Padding="16,12">
            <TextBlock Text="Melden Sie sich mit Ihrem Dropbox-Konto an (Haupt- oder freigegebenes Konto)."
                       Foreground="White" TextWrapping="Wrap" />
        </Border>
        <wv2:WebView2 x:Name="OAuthWebView" Grid.Row="1" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <Button Content="Abbrechen" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
