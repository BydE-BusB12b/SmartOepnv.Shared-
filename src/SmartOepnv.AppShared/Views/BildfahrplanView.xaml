<UserControl x:Class="SmartOepnv.AppShared.Views.BildfahrplanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="12" Margin="0,0,0,8" UniformCornerRadius="12"
                             Background="{StaticResource SmartSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Linie/Kurs" VerticalAlignment="Center" Opacity="0.8" />
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding CorridorOptions}"
                              SelectedItem="{Binding SelectedCorridor}"
                              materialDesign:HintAssist.Hint="z. B. 099/01" />

                    <TextBlock Grid.Column="4" Text="Richtung" VerticalAlignment="Center" Opacity="0.8" />
                    <ComboBox Grid.Column="6"
                              ItemsSource="{Binding DirectionOptions}"
                              SelectedItem="{Binding SelectedDirection}"
                              DisplayMemberPath="Label" />

                    <TextBlock Grid.Column="8" Text="von" VerticalAlignment="Center" Opacity="0.8" />
                    <TextBox Grid.Column="10"
                             Text="{Binding WindowStartHour, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Startstunde (0–23)" />
                    <TextBlock Grid.Column="12" Text="bis" VerticalAlignment="Center" Opacity="0.8" />
                    <TextBox Grid.Column="14"
                             Text="{Binding WindowEndHour, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Endstunde (1–24)" />

                    <Button Grid.Column="16"
                            Content="Aktualisieren"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,8,0" />
                    <Button Grid.Column="18"
                            Content="PDF"
                            Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="Kompletten Bildfahrplan (00–24 Uhr) als PDF speichern"
                            Margin="0,0,12,0" />

                    <TextBlock Grid.Column="19"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Opacity="0.85" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Opacity="0.8" Margin="0,0,8,0" />
                    <Button Content="−"
                            Command="{Binding ZoomOutCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="10,2"
                            ToolTip="Herauszoomen" />
                    <TextBlock Text="{Binding ZoomLabel}"
                               VerticalAlignment="Center"
                               MinWidth="48"
                               TextAlignment="Center"
                               Margin="8,0"
                               FontWeight="SemiBold" />
                    <Button Content="+"
                            Command="{Binding ZoomInCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="10,2"
                            ToolTip="Hineinzoomen" />
                    <Button Content="100 %"
                            Command="{Binding ZoomResetCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="8,0,0,0"
                            Padding="8,2" />
                    <TextBlock Text="Strg + Mausrad auf der Karte · Klick auf String öffnet die Fahrt"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               Opacity="0.65"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0"
                                 Padding="0"
                                 UniformCornerRadius="12"
                                 Margin="0,0,8,0"
                                 Background="{StaticResource SmartSurfaceBrush}"
                                 ClipToBounds="True">
                <ScrollViewer x:Name="ChartScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Padding="8"
                              PreviewMouseWheel="OnChartPreviewMouseWheel">
                    <Canvas x:Name="ChartCanvas"
                            Background="#FAFBFC"
                            Width="1200"
                            Height="700"
                            ClipToBounds="True"
                            Cursor="Hand" />
                </ScrollViewer>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1"
                                 Padding="12"
                                 UniformCornerRadius="12"
                                 Background="{StaticResource SmartPrimaryDarkBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Fahrten"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="Klick öffnet in Routen"
                               Foreground="#90CAF9"
                               FontSize="11"
                               Margin="0,0,0,8"
                               Opacity="0.85" />
                    <ListBox ItemsSource="{Binding TripLegend}"
                             Background="Transparent"
                             BorderThickness="0"
                             MouseDoubleClick="OnLegendDoubleClick"
                             PreviewMouseLeftButtonUp="OnLegendClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Cursor="Hand">
                                    <Border Width="14" Height="14" CornerRadius="3"
                                            Background="{Binding ColorBrush}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DisplayLine}"
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
