<UserControl x:Class="SmartOepnv.AppShared.Views.RouteStopEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SmartOepnv.AppShared.Converters"
             Foreground="White">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#0A1628" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource SmartDarkComboBox}" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Stammdaten" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" Margin="0,0,8,6" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                     Text="{Binding SelectedStop.PlannerStopCode, UpdateSourceTrigger=LostFocus}"
                     LostFocus="Field_LostFocus" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" Margin="0,0,8,6" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6"
                     Text="{Binding SelectedStop.Name, UpdateSourceTrigger=LostFocus}"
                     LostFocus="Field_LostFocus" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Anzeige:" Margin="0,0,8,6" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" MaxLength="16"
                     Text="{Binding SelectedStop.StopDisplay, UpdateSourceTrigger=LostFocus}"
                     LostFocus="Field_LostFocus" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="GPS:" Margin="0,0,8,6" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6"
                     Text="{Binding SelectedStop.GpsCoordinates, UpdateSourceTrigger=LostFocus}"
                     LostFocus="Field_LostFocus" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Hst.-GPS:" Margin="0,0,8,6" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,6"
                     Text="{Binding SelectedStop.StopCoordinates, UpdateSourceTrigger=LostFocus}"
                     LostFocus="Field_LostFocus" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="VRR-ID:" Margin="0,0,8,6" VerticalAlignment="Center" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SelectedStop.VrrStopId, UpdateSourceTrigger=LostFocus}"
                         LostFocus="Field_LostFocus" />
                <Button Grid.Column="1" Content="VRR suchen…" Command="{Binding PickVrrStopCommand}"
                        Margin="6,0,0,0" Padding="10,4" MinHeight="32"
                        Background="#1E5A9E" Foreground="White" BorderBrush="#42A5F5"
                        ToolTip="Haltestelle im VRR-Katalog suchen (wie Android)" />
            </Grid>
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Radius:" Margin="0,0,8,6" VerticalAlignment="Center" />
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,6"
                     Text="{Binding SelectedStop.Radius, UpdateSourceTrigger=LostFocus}"
                     LostFocus="Field_LostFocus" />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Zeit:" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBox Grid.Row="7" Grid.Column="1"
                     Text="{Binding SelectedStop.Time, UpdateSourceTrigger=LostFocus}"
                     LostFocus="Field_LostFocus" />
        </Grid>

        <Separator Margin="0,0,0,12" Opacity="0.35" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="▲ Nach oben" Command="{Binding MoveSelectedStopUpCommand}"
                    MinHeight="34" Padding="12,6" Margin="0,0,8,0"
                    Background="#1E5A9E" Foreground="White" BorderBrush="#42A5F5" />
            <Button Content="▼ Nach unten" Command="{Binding MoveSelectedStopDownCommand}"
                    MinHeight="34" Padding="12,6"
                    Background="#1E5A9E" Foreground="White" BorderBrush="#42A5F5" />
        </StackPanel>

        <CheckBox Content="Starthaltestelle" IsChecked="{Binding IsStartStop, Mode=TwoWay}" Margin="0,0,0,8" />

        <StackPanel Visibility="{Binding ShowStartStopFields, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
            <TextBlock Text="Ziel auswählen (DS021T):" Margin="0,0,0,4" Opacity="0.9" />
            <ComboBox ItemsSource="{Binding Ds021tDestinations}"
                      SelectedItem="{Binding SelectedDestinationDs021t, Mode=TwoWay}" Margin="0,0,0,8" />
            <TextBlock Text="Ziel auswählen (DS003a Krefeld):" Margin="0,0,0,4" Opacity="0.9" />
            <ComboBox ItemsSource="{Binding Ds003aDestinations}"
                      SelectedItem="{Binding SelectedDestinationDs003a, Mode=TwoWay}" Margin="0,0,0,8" />
            <TextBlock Text="Liniennummer (z. B. 28, _28, !28):" Margin="0,0,0,4" Opacity="0.9" />
            <TextBox Text="{Binding SelectedStop.LineNumber, UpdateSourceTrigger=LostFocus}"
                     MaxLength="4" LostFocus="Field_LostFocus" />
        </StackPanel>

        <CheckBox Content="Endhaltestelle" IsChecked="{Binding IsEndStop, Mode=TwoWay}" Margin="0,0,0,8" />

        <StackPanel Visibility="{Binding ShowEndStopFields, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
            <TextBlock Text="Endziel auswählen (DS021T):" Margin="0,0,0,4" Opacity="0.9" />
            <ComboBox ItemsSource="{Binding Ds021tDestinations}"
                      SelectedItem="{Binding SelectedEndDestinationDs021t, Mode=TwoWay}" Margin="0,0,0,8" />
            <TextBlock Text="Endziel auswählen (DS003a Krefeld):" Margin="0,0,0,4" Opacity="0.9" />
            <ComboBox ItemsSource="{Binding Ds003aDestinations}"
                      SelectedItem="{Binding SelectedEndDestinationDs003a, Mode=TwoWay}" Margin="0,0,0,8" />
            <TextBlock Text="Endziel-GPS (lat, lon):" Margin="0,0,0,4" Opacity="0.9" />
            <TextBox Text="{Binding SelectedStop.EndDestinationCoordinates, UpdateSourceTrigger=LostFocus}"
                     LostFocus="Field_LostFocus" Margin="0,0,0,8" />

            <CheckBox Content="Endhaltestellen-Ansage"
                      IsChecked="{Binding PlayEndStopAnnouncement, Mode=TwoWay}"
                      ToolTip="Hängt die Ansage „Endhaltestelle“ aus der Ansagen-Kartei nach der Haltestellenansage an"
                      Margin="0,0,0,8" />

            <CheckBox Content="Automatischer Routenwechsel"
                      IsChecked="{Binding RouteChangeEnabled, Mode=TwoWay}" Margin="0,0,0,8" />

            <StackPanel Visibility="{Binding ShowRouteChangeFields, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Linie/Kurs-Fahrt auswählen:" Margin="0,0,0,4" Opacity="0.9" />
                <ComboBox ItemsSource="{Binding LineCourseTripRoutes}"
                          SelectedItem="{Binding SelectedLineCourseTrip, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Opacity="0.75" TextWrapping="Wrap" FontSize="11"
                   Text="Ziele unter „Anzeigen &amp; Hinweise“ pflegen. Starthaltestelle = keine Ansage, dafür Ziel/Linie." />
    </StackPanel>
</UserControl>
