<UserControl x:Class="SmartOepnv.AppShared.Views.TicketingLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartOepnv.AppShared.Converters"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:MmToPreviewPxConverter x:Key="MmPx" />
        <conv:FontPtToPreviewPxConverter x:Key="FontPtPx" />
        <conv:TicketLogoImageConverter x:Key="TicketLogoImg" />
        <!-- Stempelbereich: nur Trennlinie links (freier Entwerter-Streifen, kein Rotdruck) -->
    </UserControl.Resources>

    <TabControl Margin="0,2,0,4">
        <!-- Produkte -->
        <TabItem Header="Produkte">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Linke Spalte: Liste -->
                <materialDesign:Card Grid.Column="0" Padding="12,10"
                                     VerticalAlignment="Stretch"
                                     UniformCornerRadius="10" Background="{StaticResource SmartSurfaceBrush}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Ticketprodukte" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Command="{Binding AddProductCommand}" Content="Hinzufügen"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource SmartPanelBrush}"
                                        Margin="0,0,8,8" Padding="12,6" />
                                <Button Command="{Binding RemoveProductCommand}" Content="Entfernen"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,8" Padding="12,6" />
                                <Button Command="{Binding SetAsDefaultCommand}" Content="Als Standard"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,8" Padding="12,6" />
                                <Button Command="{Binding SaveCommand}" Content="Speichern"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{StaticResource SmartAccentBrush}"
                                        Margin="0,0,8,8" Padding="12,6" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Products}"
                                 SelectedItem="{Binding SelectedProduct}"
                                 BorderThickness="1"
                                 BorderBrush="#334B7A"
                                 Background="{DynamicResource SmartBackgroundBrush}"
                                 Foreground="{DynamicResource SmartForegroundBrush}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PriceEuro, StringFormat={}{0:0.00} €}"
                                                   Margin="12,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="★" Foreground="{StaticResource SmartAccentBrush}"
                                                   Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Rechte Spalte: Editor -->
                <materialDesign:Card Grid.Column="2" Padding="12,10"
                                     VerticalAlignment="Stretch"
                                     UniformCornerRadius="10" Background="{StaticResource SmartSurfaceBrush}">
                    <Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Produkt bearbeiten" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12" />
                            <TextBlock Text="Name" Opacity="0.7" FontSize="11" />
                            <TextBox Text="{Binding SelectedProduct.Name, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />
                            <TextBlock Text="Preis (€)" Opacity="0.7" FontSize="11" />
                            <TextBox Text="{Binding SelectedProduct.PriceEuro, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />
                            <CheckBox Content="Aktiv (in der App sichtbar)"
                                      IsChecked="{Binding SelectedProduct.Active}" Margin="0,0,0,8" />
                            <CheckBox Content="Standard (Vorauswahl im Verkauf)"
                                      IsChecked="{Binding SelectedProduct.IsDefault}" Margin="0,0,0,8" />
                            <TextBlock Text="Sortierung (kleiner = weiter oben)" Opacity="0.7" FontSize="11" />
                            <TextBox Text="{Binding SelectedProduct.SortOrder, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.65" FontSize="11" Margin="0,8,0,0"
                                       Text="Eine gemeinsame Druckvorlage (Tab „Druckvorlage“) gilt für alle Produkte. Name/Preis kommen zur Laufzeit aus dem gewählten Produkt. Speichern + Fahrzeug-Sync → VERKAUF." />
                        </StackPanel>
                        <TextBlock Text="Links ein Ticket auswählen oder „Hinzufügen“."
                                   Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" Margin="24">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedProduct}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </TabItem>

        <!-- Druckvorlage: Liste | Editor | Vorschau (ohne Scrollbar, immer komplett) -->
        <TabItem Header="Druckvorlage">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.85*" MinWidth="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="0.95*" MinWidth="240" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.35*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <!-- Felderliste -->
                <materialDesign:Card Grid.Column="0" Padding="10,8"
                                     VerticalAlignment="Stretch"
                                     UniformCornerRadius="10" Background="{StaticResource SmartSurfaceBrush}">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Druckvorlage (mm)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2" />
                            <TextBlock TextWrapping="Wrap" Opacity="0.65" FontSize="10" Margin="0,0,0,6"
                                       Text="Eine Vorlage für alle Produkte. Dynamische Felder (Ticketname, Preis, …) werden beim Druck aus dem Produkt gefüllt." />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Breite" Opacity="0.7" FontSize="10" />
                                    <TextBox Text="{Binding PageWidthMm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Höhe" Opacity="0.7" FontSize="10" />
                                    <TextBox Text="{Binding PageHeightMm, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Hintergrund" Opacity="0.7" FontSize="10" />
                            <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                            <WrapPanel>
                                <Button Command="{Binding AddTemplateFieldCommand}" Content="Feld +"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource SmartPanelBrush}"
                                        Margin="0,0,6,6" Padding="10,4" />
                                <Button Command="{Binding RemoveTemplateFieldCommand}" Content="Feld −"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,6,6" Padding="10,4" />
                                <Button Command="{Binding ResetTemplateDefaultCommand}" Content="Standard"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,6,6" Padding="10,4" />
                                <Button Command="{Binding SaveCommand}" Content="Speichern"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{StaticResource SmartAccentBrush}"
                                        Margin="0,0,6,6" Padding="10,4" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding TemplateFields}"
                                 SelectedItem="{Binding SelectedField}"
                                 BorderThickness="1"
                                 BorderBrush="#334B7A"
                                 Background="{DynamicResource SmartBackgroundBrush}"
                                 Foreground="{DynamicResource SmartForegroundBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="4,2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding TypeLabel, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" " />
                                        <Run Text="{Binding X, StringFormat={}{0:0.#}}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding Y, StringFormat={}{0:0.#}}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Feld-Editor (nur hier ggf. scrollbar) -->
                <materialDesign:Card Grid.Column="2" Padding="10,8"
                                     VerticalAlignment="Stretch"
                                     UniformCornerRadius="10" Background="{StaticResource SmartSurfaceBrush}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Feld bearbeiten" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                            <TextBlock Text="Typ" Opacity="0.7" FontSize="10" />
                            <ComboBox ItemsSource="{Binding FieldTypeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedField.Type}"
                                      Margin="0,0,0,6" />
                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <StackPanel Margin="0,0,4,4">
                                    <TextBlock Text="X mm" Opacity="0.7" FontSize="10" />
                                    <TextBox Text="{Binding SelectedField.X, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="Y mm" Opacity="0.7" FontSize="10" />
                                    <TextBox Text="{Binding SelectedField.Y, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,4,4">
                                    <TextBlock Text="Breite" Opacity="0.7" FontSize="10" />
                                    <TextBox Text="{Binding SelectedField.Width, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="Höhe" Opacity="0.7" FontSize="10" />
                                    <TextBox Text="{Binding SelectedField.Height, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,4,4">
                                    <TextBlock Text="Schrift" Opacity="0.7" FontSize="10" />
                                    <TextBox Text="{Binding SelectedField.FontSize, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="Gewicht" Opacity="0.7" FontSize="10" />
                                    <ComboBox ItemsSource="{Binding FontWeightOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedField.FontWeight}" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Ausrichtung" Opacity="0.7" FontSize="10" />
                            <ComboBox ItemsSource="{Binding AlignOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedField.Align}"
                                      Margin="0,0,0,6" />
                            <TextBlock Text="Text / Vorschau" Opacity="0.7" FontSize="10" />
                            <TextBox Text="{Binding SelectedField.StaticText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                            <TextBlock Text="Logo-Datei" Opacity="0.7" FontSize="10" />
                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right"
                                        Command="{Binding ChooseTicketLogoCommand}"
                                        Content="Logo wählen…"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{StaticResource SmartAccentBrush}"
                                        Margin="6,0,0,0" Padding="10,4"
                                        VerticalAlignment="Center" />
                                <TextBox Text="{Binding SelectedField.AssetKey, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center"
                                         IsReadOnly="True" />
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="10"
                                       Text="Feld „Logo“ auswählen → „Logo wählen…“ → PNG/JPG auswählen → Speichern." />
                        </StackPanel>
                    </ScrollViewer>
                </materialDesign:Card>

                <!-- Vorschau: immer komplett, skaliert, ohne Scrollbar -->
                <materialDesign:Card Grid.Column="4" Padding="10,8"
                                     VerticalAlignment="Stretch"
                                     UniformCornerRadius="10" Background="{StaticResource SmartSurfaceBrush}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Vorschau (Druckmaßstab)"
                                   FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                        <Border Background="#2A3548" Padding="10" CornerRadius="6">
                            <Viewbox Stretch="Uniform"
                                     StretchDirection="Both"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch">
                                <!-- Papierfläche 1:1 zum ESC/POS-Bitmap (mm → px) -->
                                <Border Width="{Binding PreviewWidthPx}"
                                        Height="{Binding PreviewHeightPx}"
                                        Background="{Binding PreviewBackground}"
                                        BorderBrush="#222222" BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <ItemsControl ItemsSource="{Binding TemplateFields}"
                                                  Width="{Binding PreviewWidthPx}"
                                                  Height="{Binding PreviewHeightPx}"
                                                  ClipToBounds="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Background="Transparent"
                                                        Width="{Binding DataContext.PreviewWidthPx, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Height="{Binding DataContext.PreviewHeightPx, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemContainerStyle>
                                            <Style TargetType="ContentPresenter">
                                                <Setter Property="Canvas.Left" Value="{Binding X, Converter={StaticResource MmPx}}" />
                                                <Setter Property="Canvas.Top" Value="{Binding Y, Converter={StaticResource MmPx}}" />
                                            </Style>
                                        </ItemsControl.ItemContainerStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="{Binding Width, Converter={StaticResource MmPx}}"
                                                        Height="{Binding Height, Converter={StaticResource MmPx}}"
                                                        SnapsToDevicePixels="True">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="BorderBrush" Value="Transparent" />
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Style.Triggers>
                                                                <!-- Freier Stempelstreifen: nur vertikale Trennlinie links, kein Rotdruck -->
                                                                <DataTrigger Binding="{Binding Type}" Value="stampStripes">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="BorderBrush" Value="#111111" />
                                                                    <Setter Property="BorderThickness" Value="1.5,0,0,0" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Type}" Value="logo">
                                                                    <Setter Property="Background" Value="#F5F5F5" />
                                                                    <Setter Property="BorderBrush" Value="#BDBDBD" />
                                                                    <Setter Property="BorderThickness" Value="0.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <TextBlock Text="{Binding PreviewDisplayText}"
                                                                   FontSize="{Binding FontSize, Converter={StaticResource FontPtPx}}"
                                                                   Foreground="#111111"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"
                                                                   Margin="1,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Setter Property="TextAlignment" Value="Left" />
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="stampStripes">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="logo">
                                                                            <Setter Property="Foreground" Value="#9E9E9E" />
                                                                            <Setter Property="FontSize" Value="9" />
                                                                            <Setter Property="TextAlignment" Value="Center" />
                                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding FontWeight}" Value="bold">
                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Align}" Value="center">
                                                                            <Setter Property="TextAlignment" Value="Center" />
                                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Align}" Value="right">
                                                                            <Setter Property="TextAlignment" Value="Right" />
                                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- Logo-Bild über dem Platzhalter -->
                                                        <Image Source="{Binding AssetKey, Converter={StaticResource TicketLogoImg}}"
                                                               Stretch="Uniform"
                                                               SnapsToDevicePixels="True">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="logo">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Viewbox>
                        </Border>
                    </DockPanel>
                </materialDesign:Card>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
