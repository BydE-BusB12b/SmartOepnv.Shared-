<UserControl x:Class="SmartOepnv.AppShared.Views.StopsLibraryView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

             xmlns:conv="clr-namespace:SmartOepnv.AppShared.Converters"

             VerticalAlignment="Stretch"

             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <conv:RouteLineCourseTripFirstConverter x:Key="RouteLineCourseTripFirstConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="StopsLibrarySaveButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource SmartAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SmartAccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SaveButtonIsSuccess}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SmartSuccessOnDarkBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SmartSuccessOnDarkBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource SmartSuccessOnDarkForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StopsLibraryRemoveButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RemoveTemplateButtonIsSuccess}" Value="True">
                    <Setter Property="Background" Value="#FF4CAF50" />
                    <Setter Property="BorderBrush" Value="#FF4CAF50" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StopsLibraryRouteAssignToggleStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource SmartAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SmartAccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRouteAssignPanelOpen}" Value="True">
                    <Setter Property="Background" Value="#FFC62828" />
                    <Setter Property="BorderBrush" Value="#FFEF5350" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StopsLibraryInsertRouteButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedLightButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.InsertIntoRouteButtonIsSuccess, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Background" Value="#FF4CAF50" />
                    <Setter Property="BorderBrush" Value="#FF4CAF50" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Pfeil-Combo: Routenname steht daneben (wie Fahrweg-Editor) -->
        <ControlTemplate x:Key="StopsLibraryRoutePickerToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
                <Path HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="White" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SmartPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="StopsLibraryRoutePickerComboTemplate" TargetType="ComboBox">
            <Grid SnapsToDevicePixels="True" HorizontalAlignment="Stretch">
                <ToggleButton x:Name="ToggleButton"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              Foreground="{TemplateBinding Foreground}"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press"
                              Padding="{TemplateBinding Padding}"
                              Template="{StaticResource StopsLibraryRoutePickerToggleTemplate}" />
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       PopupAnimation="Slide"
                       Focusable="False">
                    <Grid MinWidth="360"
                          MaxHeight="{TemplateBinding MaxDropDownHeight}"
                          FocusManager.IsFocusScope="True">
                        <Border Background="{StaticResource SmartPrimaryDarkBrush}"
                                BorderBrush="{StaticResource SmartAccentBrush}"
                                BorderThickness="1"
                                CornerRadius="0,0,2,2" />
                        <DockPanel Margin="1">
                            <TextBox x:Name="RouteAssignSearchBox"
                                     DockPanel.Dock="Top"
                                     Margin="6,6,6,4"
                                     Padding="6,4"
                                     Background="#FF0D47A1"
                                     Foreground="White"
                                     CaretBrush="White"
                                     BorderBrush="{StaticResource SmartAccentBrush}"
                                     BorderThickness="1"
                                     Focusable="True"
                                     materialDesign:HintAssist.Hint="Suchen (Linie, Kurs, Fahrt, Name)"
                                     materialDesign:HintAssist.Foreground="#BBDEFB"
                                     materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource SmartAccentBrush}"
                                     Text="{Binding DataContext.RouteAssignSearchQuery, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                     Loaded="RouteAssignSearchBox_OnLoaded" />
                            <ScrollViewer SnapsToDevicePixels="True"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Visible"
                                          CanContentScroll="False"
                                          Focusable="False">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SmartDarkComboBoxScrollBar}" />
                                </ScrollViewer.Resources>
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                Focusable="False" />
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                    <Setter TargetName="PART_Popup" Property="MinHeight" Value="32" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="StopsLibraryRoutePickerCombo" TargetType="ComboBox" BasedOn="{StaticResource SmartDarkComboBox}">
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Template" Value="{StaticResource StopsLibraryRoutePickerComboTemplate}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource RouteLineCourseTripFirstConverter}}"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   ToolTip="{Binding Converter={StaticResource RouteLineCourseTripFirstConverter}}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Kein äußerer ScrollViewer: Liste scrollt in der linken Spalte, Stammdaten rechts in eigenem Bereich -->

    <Grid Margin="0,2,0,4" VerticalAlignment="Stretch">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" MinWidth="300" />

                <ColumnDefinition Width="*" MinWidth="300" />

            </Grid.ColumnDefinitions>



            <materialDesign:Card Grid.Column="0"

                                 Margin="0,0,10,0"

                                 Padding="12,10"

                                 UniformCornerRadius="10"

                                 VerticalAlignment="Stretch"

                                 Background="{StaticResource SmartSurfaceBrush}">

                <DockPanel LastChildFill="True">

                    <StackPanel DockPanel.Dock="Top">

                        <TextBlock Text="Haltestellenbibliothek"

                                   FontWeight="SemiBold"

                                   FontSize="15"

                                   Margin="0,0,0,2" />

                        <TextBlock Text="Alle Haltestellen aus Routen + Verwaltung (managedStopTemplates, ID 5-stellig)"

                                   Opacity="0.65"

                                   FontSize="10"

                                   LineHeight="13"

                                   Margin="0,0,0,6"

                                   TextWrapping="Wrap" />



                        <TextBox materialDesign:HintAssist.Hint="Suchen (Name, Anzeige, VRR, Richtung, Linie z. B. 694)"

                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"

                                 Margin="0,0,0,6"

                                 Padding="6,4" />

                        <UniformGrid Columns="2" Margin="0,0,0,8">
                            <Button Content="{Binding SortByIdButtonLabel}"
                                    Command="{Binding SortListByIdCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,0,4,0"
                                    Padding="8,2"
                                    ToolTip="Nach Haltestellen-ID sortieren (Klick: auf-/absteigend)" />
                            <Button Content="{Binding SortByNameButtonLabel}"
                                    Command="{Binding SortListByNameCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="4,0,0,0"
                                    Padding="8,2"
                                    ToolTip="Nach Haltestellenname sortieren (Klick: auf-/absteigend)" />
                        </UniformGrid>

                    </StackPanel>



                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Aktionsbuttons (werden vom Route-Panel überdeckt) -->
                        <StackPanel Grid.Row="0"
                                    Visibility="{Binding IsRouteAssignPanelOpen, Converter={StaticResource InverseBoolToVis}}">
                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <Button Content="Speichern"
                                        Command="{Binding SaveChangesCommand}"
                                        Style="{StaticResource StopsLibrarySaveButtonStyle}"
                                        Margin="0,0,4,0"
                                        Padding="8,4" />
                                <Button Content="Neue Haltestelle"
                                        Command="{Binding AddTemplateCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="4,0,0,0"
                                        Padding="8,4" />
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                <Button Content="Alle aus Routen"
                                        Command="{Binding ImportFromAllRoutesCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,4,0"
                                        Padding="8,4"
                                        ToolTip="Alle aus Routen übernehmen – fehlende Haltestellen in die Bibliothek übernehmen" />
                                <Button Content="Duplizieren"
                                        Command="{Binding DuplicateTemplateCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="4,0,0,0"
                                        Padding="8,4" />
                            </UniformGrid>
                            <Button Content="Vorlage löschen"
                                    Command="{Binding RemoveTemplateCommand}"
                                    Style="{StaticResource StopsLibraryRemoveButtonStyle}"
                                    Padding="10,4" />
                        </StackPanel>

                        <!-- Overlay: In Route übernehmen -->
                        <materialDesign:Card Grid.Row="0"
                                             Padding="10,8"
                                             UniformCornerRadius="8"
                                             Background="{StaticResource SmartPrimaryDarkBrush}"
                                             Visibility="{Binding IsRouteAssignPanelOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="In Route übernehmen"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,6"
                                           FontSize="13" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Route:"
                                               VerticalAlignment="Center"
                                               Foreground="#BBDEFB"
                                               Margin="0,0,10,6"
                                               MinWidth="48" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource StopsLibraryRoutePickerCombo}"
                                              ItemsSource="{Binding AvailableRoutes}"
                                              SelectedItem="{Binding SelectedRouteForInsert}"
                                              ToolTip="Route wählen"
                                              Margin="0,0,10,6"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SelectedRouteForInsert, Converter={StaticResource RouteLineCourseTripFirstConverter}, TargetNullValue='— Route wählen —'}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,6"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               ToolTip="{Binding SelectedRouteForInsert, Converter={StaticResource RouteLineCourseTripFirstConverter}}" />
                                </Grid>
                                <UniformGrid Columns="2">
                                    <Button Content="In Route einfügen"
                                            Command="{Binding InsertIntoRouteCommand}"
                                            Style="{StaticResource StopsLibraryInsertRouteButtonStyle}"
                                            Margin="0,0,4,0"
                                            Padding="8,4" />
                                    <Button Content="Route → Bibliothek"
                                            Command="{Binding ImportFromSelectedRouteCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="4,0,0,0"
                                            Padding="8,4"
                                            ToolTip="Route → Bibliothek importieren" />
                                </UniformGrid>
                            </StackPanel>
                        </materialDesign:Card>

                        <Button Grid.Row="1"
                                Content="{Binding RouteAssignToggleButtonLabel}"
                                Command="{Binding ToggleRouteAssignPanelCommand}"
                                Style="{StaticResource StopsLibraryRouteAssignToggleStyle}"
                                Margin="0,6,0,0"
                                Padding="10,6"
                                HorizontalAlignment="Stretch" />
                    </Grid>



                    <ListBox ItemsSource="{Binding FilteredTemplates}"

                             SelectedItem="{Binding SelectedTemplate}"

                             BorderThickness="0"

                             Background="Transparent"

                             Margin="0,2,0,0"

                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                             ScrollViewer.VerticalScrollBarVisibility="Auto"

                             ScrollViewer.CanContentScroll="False"

                             VirtualizingPanel.IsVirtualizing="True"

                             VirtualizingPanel.VirtualizationMode="Recycling">

                        <ListBox.ItemContainerStyle>

                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">

                                <Setter Property="Padding" Value="8,3" />

                                <Setter Property="Margin" Value="0,0,0,2" />

                                <Setter Property="MinHeight" Value="0" />

                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                            </Style>

                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" MinWidth="60" />

                                        <ColumnDefinition Width="Auto" MaxWidth="140" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding DisplayLabel}"

                                               TextWrapping="Wrap"

                                               FontSize="12"

                                               LineHeight="16"

                                               VerticalAlignment="Center"

                                               Margin="0,0,8,0" />

                                    <TextBlock Grid.Column="1"

                                               Text="{Binding Lines}"

                                               TextAlignment="Right"

                                               VerticalAlignment="Center"

                                               FontSize="11"

                                               Opacity="0.8"

                                               TextWrapping="Wrap"

                                               TextTrimming="CharacterEllipsis"

                                               ToolTip="{Binding Lines}" />

                                </Grid>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                </DockPanel>

            </materialDesign:Card>



            <materialDesign:Card Grid.Column="1"

                                 Padding="12,10"

                                 UniformCornerRadius="10"

                                 VerticalAlignment="Stretch"

                                 HorizontalAlignment="Stretch"

                                 MaxWidth="760"

                                 Background="{StaticResource SmartSurfaceBrush}">

                <DockPanel DataContext="{Binding SelectedTemplate}" LastChildFill="True">

                    <TextBlock DockPanel.Dock="Top"

                               Text="Stammdaten der Vorlage"

                               FontWeight="SemiBold"

                               FontSize="15"

                               Margin="0,0,0,8" />



                    <TextBlock DockPanel.Dock="Bottom"

                               Text="{Binding DataContext.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"

                               Margin="0,0,0,6"

                               TextWrapping="Wrap"

                               Opacity="0.85"

                               FontSize="11"

                               LineHeight="15" />



                    <ScrollViewer VerticalScrollBarVisibility="Auto"

                                  HorizontalScrollBarVisibility="Disabled"

                                  Padding="0,0,4,0">

                        <StackPanel>

                            <TextBlock Text="Links eine Vorlage wählen oder „Neue Haltestelle“ anlegen."

                                       Opacity="0.7"

                                       TextWrapping="Wrap"

                                       Margin="0,0,0,8">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">

                                                <Setter Property="Visibility" Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>



                            <Grid>

                                <Grid.Style>

                                    <Style TargetType="Grid">

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">

                                                <Setter Property="Visibility" Value="Collapsed" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Grid.Style>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                    <RowDefinition Height="Auto" />

                                </Grid.RowDefinitions>



                                <!-- Haltestellen-ID + VRR-ID nebeneinander -->

                                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" MinWidth="72" />

                                        <ColumnDefinition Width="16" />

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" MinWidth="90" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Haltestellen-ID:"

                                               VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9"

                                               FontSize="12" />

                                    <TextBox Grid.Column="1"

                                             Text="{Binding StopCode, UpdateSourceTrigger=PropertyChanged}"

                                             MaxLength="5" Padding="6,4" VerticalContentAlignment="Center"

                                             ToolTip="5-stellige Haltestellen-ID" />

                                    <TextBlock Grid.Column="3" Text="VRR-ID:"

                                               VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9" FontSize="12" />

                                    <TextBox Grid.Column="4"

                                             Text="{Binding DataContext.SelectedVrrStopId, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"

                                             Padding="6,4" VerticalContentAlignment="Center" />

                                    <Button Grid.Column="5"

                                            Content="VRR suchen…"

                                            Command="{Binding DataContext.PickVrrStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Margin="6,0,0,0"

                                            Padding="10,4"

                                            ToolTip="Haltestelle im VRR-Katalog suchen (wie Android)" />

                                </Grid>



                                <TextBlock Grid.Row="1" Grid.Column="0" Text="ITCS-Name:"

                                           VerticalAlignment="Center" Margin="0,0,10,6" Opacity="0.9"

                                           MinWidth="140" FontSize="12" />

                                <TextBox Grid.Row="1" Grid.Column="1"

                                         Text="{Binding StopNameItcs, UpdateSourceTrigger=PropertyChanged}"

                                         Margin="0,0,0,6" Padding="6,4" VerticalContentAlignment="Center" />



                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Haltestellenanzeige:"

                                           VerticalAlignment="Center" Margin="0,0,10,6" Opacity="0.9" FontSize="12" />

                                <TextBox Grid.Row="2" Grid.Column="1"

                                         Text="{Binding StopDisplay, UpdateSourceTrigger=PropertyChanged}"

                                         MaxLength="{Binding DataContext.Ds009TextMaxLength, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                         Margin="0,0,0,6" Padding="6,4" VerticalContentAlignment="Center" />



                                <!-- Richtung + Radius nebeneinander -->

                                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,6">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="2*" MinWidth="100" />

                                        <ColumnDefinition Width="16" />

                                        <ColumnDefinition Width="Auto" />

                                        <ColumnDefinition Width="*" MinWidth="64" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Richtung:"

                                               VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9" FontSize="12" />

                                    <TextBox Grid.Column="1"

                                             Text="{Binding DirectionDescription, UpdateSourceTrigger=PropertyChanged}"

                                             Padding="6,4" VerticalContentAlignment="Center"

                                             ToolTip="Richtung / Orientierung" />

                                    <TextBlock Grid.Column="3" Text="Radius (m):"

                                               VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9" FontSize="12" />

                                    <TextBox Grid.Column="4"

                                             Text="{Binding RadiusMeters, UpdateSourceTrigger=PropertyChanged}"

                                             Padding="6,4" VerticalContentAlignment="Center" />

                                </Grid>



                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Linien:"

                                           VerticalAlignment="Top" Margin="0,4,10,6" Opacity="0.9" FontSize="12" />

                                <TextBox Grid.Row="4" Grid.Column="1"

                                         Text="{Binding Lines, UpdateSourceTrigger=PropertyChanged}"

                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"

                                         materialDesign:HintAssist.Hint="z. B. 005, 006, 008 (kommagetrennt)"

                                         ToolTip="Liniennummer ohne Kurs (z. B. 681). Leer oder fehlende Nummern werden aus den Routen ergänzt – nie mit /Kurs."

                                         Margin="0,0,0,6" Padding="6,4" />



                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Ansage (GPS):"

                                           VerticalAlignment="Center" Margin="0,0,10,6" Opacity="0.9" FontSize="12" />

                                <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,6">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"

                                             materialDesign:HintAssist.Hint="Breite, Länge (6 Stellen) – z. B. 51.172805, 6.456152"

                                             Text="{Binding DataContext.SelectedAnnouncementCoordinates, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"

                                             Padding="6,4" VerticalContentAlignment="Center" />

                                    <Button Grid.Column="1"

                                            Content="Karte…"

                                            Command="{Binding DataContext.PickAnnouncementCoordinatesOnMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Margin="6,0,0,0"

                                            Padding="10,4"

                                            ToolTip="Standort auf der Karte wählen (wie in der App)" />

                                </Grid>



                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Haltestelle (GPS):"

                                           VerticalAlignment="Center" Margin="0,0,10,6" Opacity="0.9" FontSize="12" />

                                <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,6">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="Auto" />

                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"

                                             materialDesign:HintAssist.Hint="Breite, Länge (6 Stellen) – z. B. 51.186816, 6.454629"

                                             Text="{Binding DataContext.SelectedStopCoordinates, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"

                                             Padding="6,4" VerticalContentAlignment="Center" />

                                    <Button Grid.Column="1"

                                            Content="Karte…"

                                            Command="{Binding DataContext.PickStopCoordinatesOnMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Margin="6,0,0,0"

                                            Padding="10,4"

                                            ToolTip="Standort auf der Karte wählen (wie in der App)" />

                                </Grid>



                                <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"

                                            Margin="0,4,0,8">

                                    <CheckBox Content="Entwerter"

                                              IsChecked="{Binding EntwerterEnabled, Mode=TwoWay}"

                                              Margin="0,0,0,6"

                                              VerticalAlignment="Center"

                                              ToolTip="Vorgabe für Routen: nur wenn hier aktiv – beim Speichern auf Haltestellen mit gleicher ID. Deaktiviert hier: routenspezifische Aktivierungen bleiben und wirken nicht auf andere Haltestellen. Linie kommt in der Route automatisch." />

                                    <StackPanel Visibility="{Binding ShowEntwerterFields, Converter={StaticResource BoolToVis}}"

                                                Margin="16,0,0,0">

                                        <UniformGrid Columns="2" HorizontalAlignment="Stretch" Margin="0,0,0,4">

                                            <TextBox materialDesign:HintAssist.Hint="Wabe (3 Ziffern)"

                                                     Text="{Binding EntwerterWabe, UpdateSourceTrigger=LostFocus}"

                                                     ToolTip="DS004 Ziffer 4–6. Wird beim Speichern in passende Routen-Haltestellen übernommen. Linie (1–3) kommt in der Route automatisch."

                                                     Margin="0,0,6,0"

                                                     MaxLength="3"

                                                     Padding="6,4" />

                                            <TextBox materialDesign:HintAssist.Hint="Kurzstrecke DS004a (Standard 3 → 0031)"

                                                     Text="{Binding EntwerterKurzstrecke, UpdateSourceTrigger=LostFocus}"

                                                     ToolTip="7. Stempelstelle über DS004a Ziffer 3. Voreinstellung 3 → DS004a 0031. Beim Speichern in Routen übernommen."

                                                     Margin="6,0,0,0"

                                                     MaxLength="1"

                                                     Padding="6,4" />

                                        </UniformGrid>

                                        <TextBlock Text="{Binding EntwerterTelegramHint}"

                                                   FontSize="11"

                                                   Opacity="0.75"

                                                   TextWrapping="Wrap" />

                                    </StackPanel>

                                </StackPanel>



                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Eingebetteter Ton:"

                                           VerticalAlignment="Top" Margin="0,6,10,0" Opacity="0.9" FontSize="12" />

                                <StackPanel Grid.Row="8" Grid.Column="1">

                                    <Grid Margin="0,0,0,6">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <TextBox Text="{Binding EmbeddedSoundFileName, UpdateSourceTrigger=PropertyChanged}"

                                                 IsReadOnly="True"

                                                 Opacity="0.9"

                                                 Padding="6,4"

                                                 VerticalContentAlignment="Center" />

                                        <Button Grid.Column="1"

                                                Content="Entfernen"

                                                Command="{Binding DataContext.ClearEmbeddedSoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                Style="{StaticResource MaterialDesignOutlinedButton}"

                                                Margin="6,0,0,0"

                                                Padding="10,4" />

                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="Pause zwischen Schnipseln (Sek.):"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.9"
                                                   Margin="0,0,8,0"
                                                   FontSize="12" />
                                        <TextBox Text="{Binding DataContext.AnnouncementMergePauseSeconds, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="72"
                                                 Padding="6,4"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Stille zwischen den Ansagen, z. B. 0,3 – 0 = keine Pause" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">

                                        <Button Content="Aus Liste wählen…"

                                                Command="{Binding DataContext.PickEmbeddedSoundFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                Style="{StaticResource MaterialDesignRaisedButton}"

                                                Margin="0,0,6,0"

                                                Padding="10,4"

                                                ToolTip="Eine eingebettete Ansage aus dem Route-Paket wählen" />

                                        <Button Content="Mehrere zusammenfügen…"

                                                Command="{Binding DataContext.MergeEmbeddedSoundsFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                Style="{StaticResource MaterialDesignOutlinedButton}"

                                                Margin="0,0,6,0"

                                                Padding="10,4"

                                                ToolTip="Mehrere Ansagen nacheinander zu einer Datei zusammenfügen" />

                                        <Button Content="Datei wählen…"

                                                Command="{Binding DataContext.PickSoundFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                Style="{StaticResource MaterialDesignOutlinedButton}"

                                                Padding="10,4"

                                                ToolTip="Neue Tondatei vom PC – wird beim Speichern eingebettet" />

                                    </StackPanel>

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </ScrollViewer>

                </DockPanel>

            </materialDesign:Card>

        </Grid>

</UserControl>

