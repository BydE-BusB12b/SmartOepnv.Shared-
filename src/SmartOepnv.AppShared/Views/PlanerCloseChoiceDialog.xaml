<Window x:Class="SmartOepnv.AppShared.Views.PlanerCloseChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Planer schließen"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="480"
        MinWidth="420"
        Background="{StaticResource SmartBackgroundBrush}"
        Foreground="White"
        TextElement.Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Planer schließen"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="White"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,20"
                   FontSize="13"
                   LineHeight="20"
                   TextWrapping="Wrap"
                   Foreground="White"
                   Opacity="0.88"
                   Text="Soll der Arbeitsstand vor dem Schließen nach Dropbox gespeichert werden?&#x0a;&#x0a;Zum Testen können Sie auch ohne Speichern schließen – lokale Änderungen bleiben dann nur auf diesem PC." />

        <StackPanel Grid.Row="2">
            <Button Content="Speichern &amp; schließen"
                    IsDefault="True"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="16,8"
                    Margin="0,0,0,8"
                    Click="SaveAndClose_Click" />
            <Button Content="Ohne Speichern schließen"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="16,8"
                    Margin="0,0,0,8"
                    Click="CloseWithoutSave_Click" />
            <Button Content="Abbrechen"
                    IsCancel="True"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="16,8"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
