<UserControl x:Class="SmartOepnv.AppShared.Views.ZeitwirtschaftPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Zeitwirtschaft"
                   Style="{StaticResource SmartPageTitleStyle}"
                   FontSize="22"
                   Margin="0,0,0,4" />

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SmartPageSubtitleStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Text="Pro Fahrzeug eine JSON (zeitwirtschaft_&lt;Telefon&gt;.json). Alle Fahrzeuge werden pro Fahrer zusammengeführt und chronologisch angezeigt (Spalte Fahrzeug = Name aus Fahrzeugverwaltung). Korrekturen werden in der jeweiligen Fahrzeug-JSON gespeichert und per Dropbox an alle Apps verteilt." />
            <StackPanel Orientation="Horizontal">
                <Button Content="Aus Dropbox laden"
                        Command="{Binding LoadFromDropboxCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        Padding="14,4" />
                <Button Content="Aus Ordner laden"
                        Command="{Binding LoadFromLocalFolderCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"
                        Padding="14,4" />
                <Button Content="Zeitkorrektur"
                        Command="{Binding CorrectTimeCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        Padding="14,4" />
                <ComboBox ItemsSource="{Binding AvailableMonths}"
                          SelectedItem="{Binding SelectedMonth}"
                          DisplayMemberPath="Label"
                          MinWidth="160"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center" />
                <Button Content="PDF erstellen"
                        Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"
                        Padding="14,4" />
                <Button Content="CSV exportieren"
                        Command="{Binding ExportCsvCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="14,4" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Opacity="0.88"
                       FontSize="12" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200" MaxWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0"
                                 Padding="0"
                                 UniformCornerRadius="10"
                                 Background="{StaticResource SmartSurfaceBrush}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Mitarbeiter"
                               FontWeight="SemiBold"
                               Margin="12,10,12,6" />
                    <ListBox ItemsSource="{Binding Employees}"
                             SelectedItem="{Binding SelectedEmployee}"
                             DisplayMemberPath="DisplayLine"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="4,0,4,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2"
                                 Padding="0"
                                 UniformCornerRadius="10"
                                 Background="{StaticResource SmartSurfaceBrush}">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Zeiten pro Fahrer – alle Fahrzeuge chronologisch (Monatsfilter)"
                               FontWeight="SemiBold"
                               Margin="12,10,12,6" />
                    <DataGrid DockPanel.Dock="Top"
                              ItemsSource="{Binding TimeRows}"
                              SelectedItem="{Binding SelectedTimeRow}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="Transparent"
                              BorderThickness="0"
                              RowBackground="Transparent"
                              AlternatingRowBackground="#18FFFFFF"
                              Margin="8,0,8,0"
                              MinRowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fahrzeug"
                                                Binding="{Binding VehicleDisplayName}"
                                                Width="*" MinWidth="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Kommen"
                                                Binding="{Binding Kommen}"
                                                Width="*" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Gehen"
                                                Binding="{Binding Gehen}"
                                                Width="*" MinWidth="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Arbeitszeit"
                                                Binding="{Binding Arbeitszeit}"
                                                Width="90" />
                            <DataGridTextColumn Header="Lohnstunden"
                                                Binding="{Binding Lohnstunden}"
                                                Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border DockPanel.Dock="Bottom"
                            Margin="8,0,8,8"
                            Padding="8,10"
                            Background="#22FFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" MinWidth="130" />
                                <ColumnDefinition Width="*" MinWidth="130" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Gesamtsumme"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding TotalDuration}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding TotalDuration}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left" />
                        </Grid>
                    </Border>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
