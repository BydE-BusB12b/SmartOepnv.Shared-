<UserControl x:Class="SmartOepnv.AppShared.Views.ZeitwirtschaftPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,4,8,16" MaxWidth="720">
            <TextBlock Text="Zeitwirtschaft"
                       Style="{StaticResource SmartPageTitleStyle}"
                       FontSize="22"
                       Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource SmartPageSubtitleStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Text="Tablets stempeln Arbeitsbeginn/-ende in zeitwirtschaft_&lt;Telefon&gt;.json (Dropbox). Der Planer führt alle Dateien zusammen, erlaubt Korrekturen und CSV-Export." />

            <materialDesign:Card Padding="16" UniformCornerRadius="12"
                                 Background="{StaticResource SmartSurfaceBrush}">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Opacity="0.9" />
                    <Button Content="Zeitwirtschaft-Tool öffnen"
                            Command="{Binding OpenZeitwirtschaftToolCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Left"
                            MinWidth="220" />
                    <TextBlock Margin="0,14,0,0"
                               Opacity="0.65"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="Startet zeitwirtschaft_planer.py (Tkinter). Dropbox-Ordner im Tool wählen oder lokalen Ordner mit zeitwirtschaft_*.json." />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
