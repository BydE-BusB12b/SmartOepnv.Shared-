<UserControl x:Class="SmartOepnv.AppShared.Views.FahrerdispoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:SmartOepnv.AppShared.Views.Controls"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="960" Margin="0,0,0,8">
            <TextBlock Text="Fahrerdispo"
                       Style="{StaticResource SmartPageTitleStyle}" />
            <TextBlock Text="Fahrer den Linien und Fahrten zuordnen (Einsatzplanung)."
                       Style="{StaticResource SmartPageSubtitleStyle}" />

            <materialDesign:Card Padding="16"
                                 UniformCornerRadius="12"
                                 Background="{StaticResource SmartSurfaceBrush}"
                                 Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Dispo-Datum"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <DatePicker Grid.Column="2"
                                SelectedDate="{Binding SelectedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedDateFormat="Short"
                                materialDesign:HintAssist.Hint="Tag wählen"
                                Width="160" />
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountGroup"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"
                                                 Opacity="0.75" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding DriverCount, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" Fahrer" />
                        </TextBlock>
                        <TextBlock Text=" · "
                                   VerticalAlignment="Center"
                                   Margin="8,0" />
                        <materialDesign:PackIcon Kind="SignDirection"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0"
                                                 Opacity="0.75" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding RouteCount, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" Routen" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Padding="24"
                                 UniformCornerRadius="12"
                                 Background="{StaticResource SmartSurfaceBrush}"
                                 Margin="0,0,0,12">
                <StackPanel>
                    <materialDesign:PackIcon Kind="CalendarAccount"
                                             Width="48"
                                             Height="48"
                                             HorizontalAlignment="Left"
                                             Foreground="{StaticResource SmartAccentBrush}"
                                             Margin="0,0,0,16" />
                    <TextBlock Text="Einsatzplanung in Vorbereitung"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap"
                               Opacity="0.85"
                               LineHeight="22">
                        Hier entsteht die Zuordnung von Fahrern zu Linien, Kursen und Schichten.
                        Stammdaten kommen aus „Fahrer“ (employeeRoster) und „Routen“.
                    </TextBlock>
                </StackPanel>
            </materialDesign:Card>

            <controls:EditorStatusBanner Message="{Binding StatusMessage}"
                                         IsSuccess="{Binding StatusMessageIsSuccess}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
