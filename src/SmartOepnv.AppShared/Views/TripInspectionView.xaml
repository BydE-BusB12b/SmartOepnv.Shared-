<UserControl x:Class="SmartOepnv.AppShared.Views.TripInspectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartOepnv.AppShared.Converters"
             VerticalAlignment="Stretch"
             ClipToBounds="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid VerticalAlignment="Stretch" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="0" />
            <RowDefinition Height="Auto" MinHeight="0" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,8" UniformCornerRadius="12"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="Jetzt laden"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,12,0" />
                    <TextBlock Text="Eine Spur je Fahrzeug · 7-Tage-Loop · Upload beim Abmelden"
                               VerticalAlignment="Center" Opacity="0.75" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Opacity="0.85" MaxWidth="560" HorizontalAlignment="Right" />
            </DockPanel>
        </materialDesign:Card>

        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" MinWidth="0" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Fahrzeuge (links), ausgeblendet wenn Zeitleiste offen -->
            <materialDesign:Card Grid.Column="0"
                                 Padding="12"
                                 UniformCornerRadius="12"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Stretch"
                                 Background="{StaticResource SmartPrimaryDarkBrush}"
                                 Visibility="{Binding IsTimelineOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Fahrzeug" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasSelectedVehicle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DatePicker SelectedDate="{Binding TimelineDate}"
                                    SelectedDateFormat="Short"
                                    Margin="0,0,0,8" />
                        <Button Content="Zeitleiste"
                                Command="{Binding OpenTimelineCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Vehicles}"
                             SelectedItem="{Binding SelectedVehicle}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,6" CornerRadius="8"
                                        Background="#22000000" BorderBrush="#44FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold" />
                                        <TextBlock Text="{Binding DetailLine}" Foreground="#BBDEFB"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>

            <!-- Zeitleiste links: weißer Zeitstrahl, farbige Ereignisse -->
            <materialDesign:Card Grid.Column="0"
                                 Padding="12"
                                 UniformCornerRadius="12"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Stretch"
                                 Background="{StaticResource SmartPrimaryDarkBrush}"
                                 Visibility="{Binding IsTimelineOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Content="Schließen"
                                Command="{Binding CloseTimelineCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="White"
                                BorderBrush="White"
                                Margin="8,0,0,0"
                                Padding="10,4" />
                        <StackPanel>
                            <TextBlock Text="Zeitleiste"
                                       Foreground="White"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TimelineStatusMessage}"
                                       Foreground="White"
                                       Opacity="0.75"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <DatePicker DockPanel.Dock="Top"
                                SelectedDate="{Binding TimelineDate}"
                                SelectedDateFormat="Short"
                                Margin="0,0,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TimelineSessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Header}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Margin="14,0,0,2" />
                                        <TextBlock Text="{Binding SubHeader}"
                                                   Foreground="White"
                                                   Opacity="0.7"
                                                   FontSize="11"
                                                   Margin="14,0,0,8"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding Events}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10" MinHeight="36">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Weißer Zeitstrahl -->
                                                        <Grid Grid.Column="0" HorizontalAlignment="Center" Width="14">
                                                            <Rectangle Width="3"
                                                                       Fill="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Stretch" />
                                                            <Ellipse Width="9"
                                                                     Height="9"
                                                                     Fill="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Top"
                                                                     Margin="0,4,0,0" />
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding TimeLabel}"
                                                                       Foreground="White"
                                                                       FontWeight="SemiBold"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12" />
                                                            <TextBlock Text="{Binding KindLabel}"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="13"
                                                                       Margin="0,2,0,0"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding DetailLabel}"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       FontSize="12"
                                                                       Opacity="0.9"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1"
                                 Padding="0"
                                 UniformCornerRadius="12"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Stretch"
                                 Background="{StaticResource SmartSurfaceBrush}"
                                 ClipToBounds="True">
                <Grid x:Name="MapHost" ClipToBounds="True">
                    <wv2:WebView2 x:Name="MapWebView"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch" />
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="2"
                                 Padding="12"
                                 UniformCornerRadius="12"
                                 VerticalAlignment="Stretch"
                                 Background="{StaticResource SmartPrimaryDarkBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Zeiten" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top"
                               Text="Karte: Klick auf Spur/Punkt → Uhrzeit und ±3 Nachbarpunkte"
                               Foreground="#90CAF9" FontSize="11" Margin="0,0,0,8" Opacity="0.85" />
                    <ListBox ItemsSource="{Binding Segments}"
                             SelectedItem="{Binding SelectedSegment}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,6" CornerRadius="8"
                                        Background="#22000000" BorderBrush="#44FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" />
                                        <TextBlock Text="{Binding Detail}" Foreground="#BBDEFB"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>
        </Grid>

        <materialDesign:Card Grid.Row="2"
                             Margin="0,8,0,0"
                             Padding="12"
                             UniformCornerRadius="12"
                             MaxHeight="280"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Fahrplan Soll / Ist"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ScheduleStatusMessage}"
                               Opacity="0.8" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding ScheduleRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#14000000"
                          Visibility="{Binding HasScheduleTable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="40" />
                        <DataGridTextColumn Header="Haltestelle" Binding="{Binding StopName}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="Soll" Binding="{Binding PlannedLabel}" Width="90" />
                        <DataGridTextColumn Header="Ist" Binding="{Binding ActualLabel}" Width="90" />
                        <DataGridTextColumn Header="Diff" Binding="{Binding DelayLabel}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
