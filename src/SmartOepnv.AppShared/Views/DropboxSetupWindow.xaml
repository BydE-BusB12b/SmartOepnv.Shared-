<Window x:Class="SmartOepnv.AppShared.Views.DropboxSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:SmartOepnv.AppShared.Views"
        Title="Dropbox einrichten"
        Height="640" Width="760"
        MinHeight="520" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource SmartBackgroundBrush}"
        Foreground="White"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Vor der Anmeldung Dropbox verbinden und den Ordnerpfad prüfen (z. B. /App/Smart ÖPNV)."
                   TextWrapping="Wrap"
                   Margin="8,4,8,12"
                   Opacity="0.85"
                   FontSize="13" />
        <views:SettingsView Grid.Row="1" />
        <Button Grid.Row="2"
                Content="Fertig"
                HorizontalAlignment="Right"
                Margin="8,12,8,4"
                Padding="20,8"
                IsDefault="True"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Click="Close_Click" />
    </Grid>
</Window>
