<UserControl x:Class="SmartOepnv.AppShared.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartOepnv.AppShared.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:RouteStopStrikeThroughConverter x:Key="RouteStopStrikeThroughConverter" />
        <conv:RouteStopTimeOrderWarningConverter x:Key="RouteStopTimeOrderWarningConverter" />
        <conv:RouteStopRouteChangeDisplayConverter x:Key="RouteStopRouteChangeDisplayConverter" />
        <conv:RouteStopRouteChangeVisibleConverter x:Key="RouteStopRouteChangeVisibleConverter" />
        <Style x:Key="RoutesSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource SmartAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SmartAccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SaveButtonIsSuccess}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SmartSuccessOnDarkBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SmartSuccessOnDarkBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource SmartSuccessOnDarkForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="300" />
            <ColumnDefinition Width="2*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="12"
                             VerticalAlignment="Stretch"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Routen" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                <TextBox DockPanel.Dock="Top"
                         materialDesign:HintAssist.Hint="Suchen (Name, Linie/Kurs, Fahrt)"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" />
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button Content="Route hinzufügen" Command="{Binding AddRouteCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,0,8" />
                    <Button Content="Route bearbeiten" Command="{Binding EditRouteCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,8" />
                    <Button Content="Route löschen" Command="{Binding RemoveRouteCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding FilteredRoutes}" SelectedItem="{Binding SelectedRoute}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Column="1" Padding="16" UniformCornerRadius="12"
                             VerticalAlignment="Stretch"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button DockPanel.Dock="Right"
                            Content="Speichern"
                            Command="{Binding SaveChangesCommand}"
                            MinWidth="120"
                            Margin="12,0,0,0"
                            Style="{StaticResource RoutesSaveButtonStyle}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               Opacity="0.8"
                               TextWrapping="Wrap" />
                </DockPanel>

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="{Binding SelectedRoute, TargetNullValue='— Keine Route ausgewählt —'}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource SmartPrimaryBrush}" />
                    <Button Content="{Binding RouteSettingsButtonLabel}"
                            Command="{Binding ToggleRouteSettingsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left" />
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  MaxHeight="280"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsRouteSettingsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Verkehrstage"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Betriebstag je Tag: 03:00 bis 02:59 Uhr am Folgetag · ab 03:00 neuer Tag · alle Tage = täglich in der App"
                                       Opacity="0.7"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding RouteOperatingDaySelections}"
                                          Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,12,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding RouteOperatingDaysDisplay}"
                                       Opacity="0.75"
                                       FontSize="11"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding HasRouteOperatingDaysDisplay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Gültigkeit (optional)"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Kalenderdatum von/bis (TT.MM.JJJJ) – Route erscheint nur in diesem Zeitraum in der App (neue Tablets). Leer = unbegrenzt."
                                       Opacity="0.7"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Datum von (TT.MM.JJJJ)"
                                     Text="{Binding RouteDateFrom, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2"
                                     materialDesign:HintAssist.Hint="Datum bis (TT.MM.JJJJ)"
                                     Text="{Binding RouteDateTo, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Text="{Binding RouteDateRangeDisplay}"
                                       Opacity="0.75"
                                       FontSize="11"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding HasRouteDateRangeDisplay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Einzelne Betriebstage (optional)"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Kommagetrennt, z. B. 28.07, 30.07, 31.07, 07.08 – nur an diesen Tagen in der App (zusätzlich zu Verkehrstagen und von/bis). Leer = alle Tage im Zeitraum."
                                       Opacity="0.7"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <TextBox materialDesign:HintAssist.Hint="z. B. 28.07, 30.07.2026, 31.07, 07.08"
                                     Text="{Binding RouteOperatingDatesText, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,0,0,4" />
                            <TextBlock Text="{Binding RouteOperatingDatesDisplay}"
                                       Opacity="0.75"
                                       FontSize="11"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding HasRouteOperatingDatesDisplay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Haltestellenanzeige Zieltext"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="DS009-Wechselanzeige Linie/Ziel (z. B. W-Vohwinkel) – wechselt mit Datum/Uhrzeit, wenn die Haltestelle erreicht ist."
                                       Opacity="0.7"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <TextBox materialDesign:HintAssist.Hint="Zieltext (z. B. W-Vohwinkel)"
                                     Text="{Binding RouteInteriorDisplayDestination, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="16"
                                     Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Liste" VerticalAlignment="Center" Margin="0,0,8,10" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding RouteItcsRouteListEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.75" FontSize="11"
                                               Text="In ITCS-Routenliste (Route wählen)" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hauptnutzer" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding RouteMainDeviceOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.75" FontSize="11"
                                               Text="Route nur für Hauptnutzergeräte (Liste &amp; Linie/Kurs)" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Markierte Hauptnutzer-Routen sind auf Mitarbeitergeräten weder in der ITCS-Routenliste noch in der Linie/Kurs-Suche sichtbar."
                                       Opacity="0.7"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="Haltestellen" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                        <TextBlock Text="Haltestelle anklicken zum Bearbeiten · ▲▼ Reihenfolge · ✕ löschen"
                                   Opacity="0.75" FontSize="11" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Aus Kartei" Command="{Binding AddStopFromLibraryCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    ToolTip="Haltestelle aus der Haltestellenbibliothek einfügen" />
                            <Button Content="Nav übernehmen" Command="{Binding OfferNavReuseCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Gesnappte Navidaten aus ähnlichen Routen übernehmen (auch Teilabschnitte)" />
                            <Button Content="+" Command="{Binding AddStopCommand}" Margin="0,0,8,8" Width="36"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Leere Haltestelle" />
                            <Button Content="Zeile löschen" Command="{Binding RemoveSelectedStopCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="▲" Command="{Binding MoveSelectedStopUpCommand}" Margin="0,0,4,8" Width="36"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Nach oben" />
                            <Button Content="▼" Command="{Binding MoveSelectedStopDownCommand}" Margin="0,0,8,8" Width="36"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Nach unten" />
                            <Button Content="Fahrplan" Command="{Binding ShowAutoScheduleCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    ToolTip="Automatische Fahrplanerstellung (wie in der App)" />
                            <Button Content="Navidaten kopieren" Command="{Binding CopyNavigationDataCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Fahrweg von der Fahrplan-Vorlagen-Route übernehmen (nur Fahrplan-Fahrten)" />
                            <Button Content="📄 Fahrplan" Command="{Binding ExportScheduleHtmlCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="HTML-Fahrplan der ausgewählten Route öffnen" />
                            <Button Content="Routenschnur" Command="{Binding ShowRouteChainCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    ToolTip="Linie/Kurs-Fahrten und verbundene Routenschnur mit Fahrplan prüfen" />
                            <Button Content="−1 Min" Command="{Binding ShiftAllStopTimesEarlierCommand}" Margin="0,0,4,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Alle Haltestellenzeiten 1 Minute früher (Abstände bleiben)" />
                            <Button Content="+1 Min" Command="{Binding ShiftAllStopTimesLaterCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Alle Haltestellenzeiten 1 Minute später (Abstände bleiben)" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Row="2" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding StopTimeOrderWarningText}"
                               Foreground="#FFFF5252"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasAnyStopTimeOrderWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RouteStopCols" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Margin="12,0,4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="2" Text="Zeit" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="3" Text="Anzeige" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="4" Text="VRR" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                    </Grid>
                    <ListBox x:Name="StopsList" Grid.Row="2"
                             ItemsSource="{Binding Stops}" SelectedItem="{Binding SelectedStop}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="StopsList_PreviewMouseLeftButtonDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#22FFFFFF" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RouteStopCols" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PlannerStopCode}"
                                                   Margin="4,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Margin="12,0,4,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Converter={StaticResource RouteStopStrikeThroughConverter}}"
                                                                     Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="#FF8A80" />
                                                            <Setter Property="Opacity" Value="0.9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Time}"
                                                   Margin="4,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   ToolTip="Rot = Uhrzeit liegt vor der vorherigen Haltestelle">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource RouteStopTimeOrderWarningConverter}">
                                                    <Binding />
                                                    <Binding ElementName="StopsList" Path="DataContext" />
                                                    <Binding ElementName="StopsList" Path="DataContext.StopTimeOrderWarningTick" />
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding StopDisplay}"
                                                   Margin="4,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding VrrStopId}"
                                                   Margin="4,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="5" Content="✕"
                                                Command="{Binding DataContext.RemoveStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="0" Width="26" Height="26" ToolTip="Zeile löschen"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Margin="80,0,0,2"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="#FF81D4FA"
                                               TextWrapping="Wrap"
                                               ToolTip="Automatischer Routenwechsel an dieser Endhaltestelle">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource RouteStopRouteChangeVisibleConverter}">
                                                <Binding />
                                                <Binding ElementName="StopsList" Path="DataContext.RouteChangeDisplayTick" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource RouteStopRouteChangeDisplayConverter}">
                                                <Binding />
                                                <Binding ElementName="StopsList" Path="DataContext.RouteChangeDisplayTick" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </Grid>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
