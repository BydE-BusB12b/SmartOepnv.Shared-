<UserControl x:Class="SmartOepnv.AppShared.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="12"
                             VerticalAlignment="Stretch"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Routen" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button Content="Route hinzufügen" Command="{Binding AddRouteCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,0,8" />
                    <Button Content="Route löschen" Command="{Binding RemoveRouteCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}"
                             BorderThickness="0" Background="Transparent" />
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Column="1" Padding="16" UniformCornerRadius="12"
                             VerticalAlignment="Stretch"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Haltestellen" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock Text="Haltestelle anklicken zum Bearbeiten · ▲▼ Reihenfolge · ✕ löschen"
                               Opacity="0.75" FontSize="11" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Aus Kartei" Command="{Binding AddStopFromLibraryCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                ToolTip="Haltestelle aus der Haltestellenbibliothek einfügen" />
                        <Button Content="+" Command="{Binding AddStopCommand}" Margin="0,0,8,0" Width="36"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="Leere Haltestelle" />
                        <Button Content="Zeile löschen" Command="{Binding RemoveSelectedStopCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Content="▲" Command="{Binding MoveSelectedStopUpCommand}" Margin="0,0,4,0" Width="36"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="Nach oben" />
                        <Button Content="▼" Command="{Binding MoveSelectedStopDownCommand}" Margin="0,0,8,0" Width="36"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="Nach unten" />
                        <Button Content="Fahrplan" Command="{Binding ShowAutoScheduleCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                ToolTip="Automatische Fahrplanerstellung (wie in der App)" />
                        <Button Content="📄 Fahrplan" Command="{Binding ExportScheduleHtmlCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                ToolTip="HTML-Fahrplan der ausgewählten Route öffnen" />
                        <Button Content="Speichern" Command="{Binding SaveChangesCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Opacity="0.8"
                           TextWrapping="Wrap" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Margin="12,0,4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="2" Text="Zeit" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="3" Text="Anzeige" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="4" Text="VRR" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                    </Grid>
                    <ListBox x:Name="StopsList" Grid.Row="1"
                             ItemsSource="{Binding Stops}" SelectedItem="{Binding SelectedStop}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="StopsList_PreviewMouseLeftButtonDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#22FFFFFF" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding PlannerStopCode}"
                                               Margin="4,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                               Margin="12,0,4,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Time}"
                                               Margin="4,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding StopDisplay}"
                                               Margin="4,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding VrrStopId}"
                                               Margin="4,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="5" Content="✕"
                                            Command="{Binding DataContext.RemoveStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="0" Width="26" Height="26" ToolTip="Zeile löschen"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
