<UserControl x:Class="SmartOepnv.AppShared.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartOepnv.AppShared.Converters"
             xmlns:helpers="clr-namespace:SmartOepnv.AppShared.Helpers">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <conv:RouteStopStrikeThroughConverter x:Key="RouteStopStrikeThroughConverter" />
        <conv:RouteStopTimeOrderWarningConverter x:Key="RouteStopTimeOrderWarningConverter" />
        <conv:RouteStopRouteChangeDisplayConverter x:Key="RouteStopRouteChangeDisplayConverter" />
        <conv:RouteStopRouteChangeVisibleConverter x:Key="RouteStopRouteChangeVisibleConverter" />
        <conv:RouteStopRoleBrushConverter x:Key="RouteStopRoleBrushConverter" />
        <conv:CompactRouteListLabelConverter x:Key="CompactRouteListLabelConverter" />
        <conv:RouteListLabelConverter x:Key="RouteListLabelConverter" />
        <conv:CalendarLaneMarginConverter x:Key="CalendarLaneMarginConverter" />
        <Style x:Key="ChainRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RouteModeIndividualButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Foreground" Value="{StaticResource SmartPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ListByRouteChain}" Value="False">
                    <Setter Property="Background" Value="{StaticResource SmartAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SmartAccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RouteModeChainButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Foreground" Value="{StaticResource SmartPrimaryBrush}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ListByRouteChain}" Value="True" />
                        <Condition Binding="{Binding ShowCalendar}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SmartAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SmartAccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RouteModeCalendarButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Foreground" Value="{StaticResource SmartPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowCalendar}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SmartAccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SmartAccentBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoutesSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource SmartAccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SmartAccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SaveButtonIsSuccess}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SmartSuccessOnDarkBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SmartSuccessOnDarkBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource SmartSuccessOnDarkForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RoutesDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Foreground" Value="#EF5350" />
            <Setter Property="BorderBrush" Value="#EF5350" />
        </Style>
        <Style x:Key="Ds009Length16ButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDs009Length16}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SmartSuccessOnDarkBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SmartSuccessOnDarkBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource SmartSuccessOnDarkForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Ds009Length20ButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="8,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDs009Length20}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SmartSuccessOnDarkBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource SmartSuccessOnDarkBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource SmartSuccessOnDarkForegroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="300" />
            <ColumnDefinition Width="2*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="12"
                             VerticalAlignment="Stretch"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="{Binding RouteListTitle}" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,8">
                    <Button Content="Einzelne Routen"
                            Command="{Binding ShowIndividualRoutesCommand}"
                            Style="{StaticResource RouteModeIndividualButton}"
                            Margin="0,0,4,0"
                            Padding="4,6" />
                    <Button Content="Routenschnüre"
                            Command="{Binding ShowRouteChainsCommand}"
                            Style="{StaticResource RouteModeChainButton}"
                            Margin="4,0,4,0"
                            Padding="4,6" />
                    <Button Content="Kalender"
                            Command="{Binding ShowRouteCalendarCommand}"
                            Style="{StaticResource RouteModeCalendarButton}"
                            Margin="4,0,0,0"
                            Padding="4,6" />
                </UniformGrid>
                <TextBox DockPanel.Dock="Top"
                         materialDesign:HintAssist.Hint="{Binding RouteSearchHint}"
                         helpers:LiveText.Source="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12" />
                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,12">
                    <Button Content="Route hinzufügen"
                            Command="{Binding AddRouteCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,4,4"
                            Padding="8,6" />
                    <Button Content="Route bearbeiten"
                            Command="{Binding EditRouteCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="4,0,0,4"
                            Padding="8,6" />
                    <Button Content="Route löschen"
                            Command="{Binding RemoveRouteCommand}"
                            Style="{StaticResource RoutesDeleteButtonStyle}"
                            Margin="0,4,4,0"
                            Padding="8,6" />
                    <Button Content="Speichern"
                            Command="{Binding SaveChangesCommand}"
                            Style="{StaticResource RoutesSaveButtonStyle}"
                            Margin="4,4,0,0"
                            Padding="8,6" />
                </UniformGrid>
                <ListBox ItemsSource="{Binding FilteredRoutes}"
                         SelectedItem="{Binding RouteListSelection}"
                         BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding DataContext.ListByRouteChain, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource RouteListLabelConverter}">
                                            <Binding />
                                            <Binding Path="DataContext"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                    <TextBlock.ToolTip>
                                        <MultiBinding Converter="{StaticResource RouteListLabelConverter}">
                                            <Binding />
                                            <Binding Path="DataContext"
                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                                <Button Style="{StaticResource ChainRowButton}"
                                        Click="ChainRow_Click"
                                        ToolTip="Fahrten dieser Routenschnur"
                                        Visibility="{Binding DataContext.ListByRouteChain, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="▾" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.75" />
                                        <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource RouteListLabelConverter}">
                                                    <Binding />
                                                    <Binding Path="DataContext"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Column="1" Padding="16" UniformCornerRadius="12"
                             VerticalAlignment="Stretch"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Bottom"
                           Margin="0,12,0,0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           TextWrapping="Wrap" />

                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"
                            Visibility="{Binding ShowCalendar, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding SelectedRouteListLabel}"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,8"
                               Foreground="{StaticResource SmartPrimaryBrush}" />
                    <TextBlock Text="Haltestellen" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{Binding RouteSettingsButtonLabel}"
                                Command="{Binding ToggleRouteSettingsCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left" />
                        <TextBox Grid.Column="2"
                                 materialDesign:HintAssist.Hint="Haltestellenanzeige Zieltext"
                                 Text="{Binding RouteInteriorDisplayDestination, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="{Binding Ds009TextMaxLength}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    ToolTip="DS009-Textlänge für Zieltext und Haltestellenanzeige (wie in der App)">
                            <TextBlock Text="DS009"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Opacity="0.75"
                                       FontSize="12" />
                            <Button Content="16"
                                    Command="{Binding SetDs009TextLengthCommand}"
                                    CommandParameter="16"
                                    Style="{StaticResource Ds009Length16ButtonStyle}" />
                            <Button Content="20"
                                    Command="{Binding SetDs009TextLengthCommand}"
                                    CommandParameter="20"
                                    Style="{StaticResource Ds009Length20ButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <TextBox materialDesign:HintAssist.Hint="Hinweis dieser Route"
                             Text="{Binding RouteInteriorHint, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"
                             ToolTip="Steht unten auf der Innenanzeige, solange kein Liveticker mit Zeitfenster läuft." />
                    <ComboBox Margin="0,8,0,0"
                              HorizontalAlignment="Left"
                              MinWidth="240"
                              materialDesign:HintAssist.Hint="Ansagestimme"
                              materialDesign:HintAssist.IsFloating="True"
                              ItemsSource="{Binding AnnouncementVoiceChoices}"
                              SelectedItem="{Binding RouteAnnouncementVoice}"
                              ToolTip="Linguatec Petra ist die bisherige Stimme. Stimme 2 sucht dieselbe Datei mit _2 vor der Endung und nimmt Petra, wenn die Datei fehlt." />
                </StackPanel>

                <Grid>
                    <Grid Visibility="{Binding ShowCalendar, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  MaxHeight="280"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsRouteSettingsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Verkehrstage"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Betriebstag je Tag: 03:00 bis 02:59 Uhr am Folgetag · ab 03:00 neuer Tag · alle Tage = täglich in der App"
                                       Opacity="0.7"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding RouteOperatingDaySelections}"
                                          Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,12,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding RouteOperatingDaysDisplay}"
                                       Opacity="0.75"
                                       FontSize="11"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding HasRouteOperatingDaysDisplay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Gültigkeit (optional)"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Datum von (TT.MM.JJJJ)"
                                     Text="{Binding RouteDateFrom, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Grid.Column="2"
                                     materialDesign:HintAssist.Hint="Datum bis (TT.MM.JJJJ)"
                                     Text="{Binding RouteDateTo, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <TextBlock Text="{Binding RouteDateRangeDisplay}"
                                       Opacity="0.75"
                                       FontSize="11"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding HasRouteDateRangeDisplay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="Einzelne Betriebstage (optional)"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                            <TextBox materialDesign:HintAssist.Hint="z. B. 28.07, 30.07.2026, 31.07, 07.08"
                                     Text="{Binding RouteOperatingDatesText, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,0,0,4" />
                            <TextBlock Text="{Binding RouteOperatingDatesDisplay}"
                                       Opacity="0.75"
                                       FontSize="11"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding HasRouteOperatingDatesDisplay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Liste" VerticalAlignment="Center" Margin="0,0,8,10" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding RouteItcsRouteListEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.75" FontSize="11"
                                               Text="In ITCS-Routenliste (Route wählen)" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hauptnutzer" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  IsChecked="{Binding RouteMainDeviceOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.75" FontSize="11"
                                               Text="Route nur für Hauptnutzergeräte (Liste &amp; Linie/Kurs)" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Markierte Hauptnutzer-Routen sind auf Mitarbeitergeräten weder in der ITCS-Routenliste noch in der Linie/Kurs-Suche sichtbar."
                                       Opacity="0.7"
                                       FontSize="10"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Aus Kartei" Command="{Binding AddStopFromLibraryCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    ToolTip="Haltestelle aus der Haltestellenbibliothek einfügen" />
                            <Button Content="Nav übernehmen" Command="{Binding OfferNavReuseCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Gesnappte Navidaten aus ähnlichen Routen übernehmen (auch Teilabschnitte)" />
                            <Button Content="+" Command="{Binding AddStopCommand}" Margin="0,0,8,8" Width="36"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Leere Haltestelle" />
                            <Button Content="Zeile löschen" Command="{Binding RemoveSelectedStopCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button Content="▲" Command="{Binding MoveSelectedStopUpCommand}" Margin="0,0,4,8" Width="36"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Nach oben" />
                            <Button Content="▼" Command="{Binding MoveSelectedStopDownCommand}" Margin="0,0,8,8" Width="36"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Nach unten" />
                            <Button Content="Fahrplan" Command="{Binding ShowAutoScheduleCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    ToolTip="Fahrplan automatisch erstellen, Umlauf importieren oder als HTML/PDF öffnen" />
                            <Button Content="Navidaten kopieren" Command="{Binding CopyNavigationDataCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Fahrweg von der Fahrplan-Vorlagen-Route übernehmen (nur Fahrplan-Fahrten)" />
                            <Button Content="Routenschnur" Command="{Binding ShowRouteChainCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    ToolTip="Linie/Kurs-Fahrten und verbundene Routenschnur mit Fahrplan prüfen" />
                            <Button Content="Verknüpfen" Command="{Binding LinkRouteChangeCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    ToolTip="Routenwechsel an der Endhaltestelle schnell setzen (Standard + Datum-Abweichungen)" />
                            <Button Content="−1 Min" Command="{Binding ShiftAllStopTimesEarlierCommand}" Margin="0,0,4,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Alle Haltestellenzeiten 1 Minute früher (Abstände bleiben)" />
                            <Button Content="+1 Min" Command="{Binding ShiftAllStopTimesLaterCommand}" Margin="0,0,8,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    ToolTip="Alle Haltestellenzeiten 1 Minute später (Abstände bleiben)" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding StopTimeOrderWarningText}"
                               Foreground="#FFFF5252"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasAnyStopTimeOrderWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="0" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Margin="12,0,4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="2" Text="Zeit" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="3" Text="Anzeige" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                        <TextBlock Grid.Column="4" Text="VRR" FontWeight="SemiBold" Margin="4,0" Opacity="0.85" />
                    </Grid>
                    <ListBox x:Name="StopsList" Grid.Row="2"
                             ItemsSource="{Binding Stops}" SelectedItem="{Binding SelectedStop}"
                             BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="StopsList_PreviewMouseLeftButtonDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource SmartAccentBrush}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="Grün = Starthaltestelle, Rot = Endhaltestelle, Gelb = Zielwechsel">
                                    <StackPanel.Background>
                                        <MultiBinding Converter="{StaticResource RouteStopRoleBrushConverter}">
                                            <Binding />
                                            <Binding ElementName="StopsList" Path="DataContext.RouteChangeDisplayTick" />
                                        </MultiBinding>
                                    </StackPanel.Background>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="0" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PlannerStopCode}"
                                                   Margin="4,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   Margin="12,0,4,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Converter={StaticResource RouteStopStrikeThroughConverter}}"
                                                                     Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                            <Setter Property="Foreground" Value="#FF8A80" />
                                                            <Setter Property="Opacity" Value="0.9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Time}"
                                                   Margin="4,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   ToolTip="Rot = Uhrzeit liegt vor der vorherigen Haltestelle">
                                            <TextBlock.Foreground>
                                                <MultiBinding Converter="{StaticResource RouteStopTimeOrderWarningConverter}">
                                                    <Binding />
                                                    <Binding ElementName="StopsList" Path="DataContext" />
                                                    <Binding ElementName="StopsList" Path="DataContext.StopTimeOrderWarningTick" />
                                                </MultiBinding>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding StopDisplay}"
                                                   Margin="4,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding VrrStopId}"
                                                   Margin="4,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="5" Content="✕"
                                                Command="{Binding DataContext.RemoveStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="0" Width="26" Height="26" ToolTip="Zeile löschen"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Margin="80,0,0,2"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="#FF81D4FA"
                                               TextWrapping="Wrap"
                                               ToolTip="Automatischer Routenwechsel an dieser Endhaltestelle">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource RouteStopRouteChangeVisibleConverter}">
                                                <Binding />
                                                <Binding ElementName="StopsList" Path="DataContext.RouteChangeDisplayTick" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource RouteStopRouteChangeDisplayConverter}">
                                                <Binding />
                                                <Binding ElementName="StopsList" Path="DataContext.RouteChangeDisplayTick" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                    </Grid>
                    <DockPanel Visibility="{Binding ShowCalendar, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="‹"
                                    Command="{Binding ShowPreviousCalendarMonthCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="40"
                                    Margin="0,0,8,0"
                                    ToolTip="Voriger Monat" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CalendarTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="2"
                                    Content="›"
                                    Command="{Binding ShowNextCalendarMonthCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="40"
                                    ToolTip="Nächster Monat" />
                        </Grid>
                        <UniformGrid DockPanel.Dock="Top" Columns="7" Margin="0,0,0,4">
                            <TextBlock Text="Mo" HorizontalAlignment="Center" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Text="Di" HorizontalAlignment="Center" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Text="Mi" HorizontalAlignment="Center" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Text="Do" HorizontalAlignment="Center" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Text="Fr" HorizontalAlignment="Center" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Text="Sa" HorizontalAlignment="Center" FontWeight="SemiBold" Opacity="0.7" />
                            <TextBlock Text="So" HorizontalAlignment="Center" FontWeight="SemiBold" Opacity="0.7" />
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding CalendarWeeks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1,0,2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="22" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ItemsControl Grid.Row="0" ItemsSource="{Binding Days}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="1,0" Padding="2,0" BorderThickness="1" BorderBrush="#33FFFFFF">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Opacity" Value="1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.4" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource SmartAccentBrush}" />
                                                                        <Setter Property="BorderThickness" Value="2" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding DayNumber}"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource SmartForegroundBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Bars}" Margin="0,2,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                    </Grid>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Grid.Column" Value="{Binding Column}" />
                                                    <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
                                                    <Setter Property="Margin" Value="{Binding Lane, Converter={StaticResource CalendarLaneMarginConverter}}" />
                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}"
                                                            ToolTip="{Binding Label}"
                                                            Command="{Binding DataContext.SelectCalendarMeasureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding HeadRouteKey}"
                                                            Height="20"
                                                            Padding="6,0"
                                                            FontSize="11"
                                                            Foreground="White"
                                                            Background="#1E5A9E"
                                                            BorderThickness="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Left"
                                                            Cursor="Hand" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </materialDesign:Card>
        <Popup x:Name="ChainTripPopup"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="White"
                    BorderBrush="#90CAF9"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="4"
                    MaxHeight="320">
                <ListBox x:Name="ChainTripList"
                         BorderThickness="0"
                         Background="White"
                         Foreground="#0A1628"
                         MaxHeight="300"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ChainTripList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="#0A1628" />
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#BBDEFB" />
                                    <Setter Property="Foreground" Value="#0A1628" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource CompactRouteListLabelConverter}}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="#0A1628"
                                       Margin="2,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
