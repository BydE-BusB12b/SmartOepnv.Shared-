<UserControl x:Class="SmartOepnv.AppShared.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="12"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Routen" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBox Text="{Binding NewRouteName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Neue Route"
                             Margin="0,0,0,8" />
                    <Button Content="Route hinzufügen" Command="{Binding AddRouteCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,0,8" />
                    <Button Content="Route löschen" Command="{Binding RemoveRouteCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Routes}" SelectedItem="{Binding SelectedRoute}"
                         BorderThickness="0" Background="Transparent" />
            </DockPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Column="1" Padding="16" UniformCornerRadius="12"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Haltestellen" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <Button Content="Haltestelle +" Command="{Binding AddStopCommand}" Margin="16,0,8,0"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="Speichern" Command="{Binding SaveChangesCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="Haltestellen-Änderungen sofort lokal sichern" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Margin="0,12,0,0" Opacity="0.8"
                           TextWrapping="Wrap" />
                <DataGrid ItemsSource="{Binding Stops}" AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding PlannerStopCode, UpdateSourceTrigger=PropertyChanged}" Width="56" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        <DataGridTextColumn Header="GPS" Binding="{Binding GpsCoordinates, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                        <DataGridTextColumn Header="VRR-ID" Binding="{Binding VrrStopId, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                        <DataGridTextColumn Header="Anzeige" Binding="{Binding StopDisplay, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                        <DataGridTextColumn Header="Zeit" Binding="{Binding Time, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                        <DataGridTemplateColumn Header="" Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Command="{Binding DataContext.RemoveStopCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
    </ScrollViewer>
</UserControl>
