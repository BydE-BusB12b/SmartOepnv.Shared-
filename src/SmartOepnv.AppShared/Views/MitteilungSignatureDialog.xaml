<Window x:Class="SmartOepnv.AppShared.Views.MitteilungSignatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Unterschrift wählen"
        Width="560" Height="640"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartBackgroundBrush}"
        Foreground="White"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="100" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Gespeicherte Unterschriften"
                   FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />

        <ListBox x:Name="SignatureList"
                 Grid.Row="1"
                 DisplayMemberPath="Name"
                 Background="{StaticResource SmartSurfaceBrush}"
                 BorderBrush="#42A5F5"
                 Foreground="White" />

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Neue Unterschrift zeichnen"
                       FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="Mit Maus oder Finger unterschreiben, danach „Zeichnung speichern“."
                       Opacity="0.7" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap" />
            <Border BorderBrush="#42A5F5" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                <InkCanvas x:Name="SignatureInk"
                           Height="140"
                           Background="White"
                           EditingMode="Ink"
                           Cursor="Pen" />
            </Border>
            <TextBox x:Name="NewNameBox"
                     materialDesign:HintAssist.Hint="Anzeigename (optional)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,8" />
            <WrapPanel>
                <Button Content="Zeichnung speichern" Click="SaveDrawingButton_Click" Margin="0,0,8,8"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Zeichnung löschen" Click="ClearDrawingButton_Click" Margin="0,0,8,8"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button Content="Bild laden…" Click="CreateButton_Click" Margin="0,0,8,8"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                <Button Content="Eintrag löschen" Click="DeleteButton_Click" Margin="0,0,0,8"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Keine" Click="ClearButton_Click" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button Content="Abbrechen" Click="CancelButton_Click" Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button Content="Übernehmen" Click="OkButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
