<UserControl x:Class="SmartOepnv.AppShared.Views.DisplaysOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <DockPanel Margin="0,0,0,8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Anzeigen &amp; Hinweise"
                       FontWeight="SemiBold" FontSize="18" Margin="0,0,0,4" />
            <TextBlock Text="Zielanzeigen und datumgesteuerte Hinweise – werden mit dem Routen-JSON (Dropbox) übertragen. Linienführung über Navidaten."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="11" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom"
                   Text="{Binding StatusMessage}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Opacity="0.85"
                   FontSize="12" />

        <TabControl Style="{StaticResource MaterialDesignFilledTabControl}" VerticalAlignment="Stretch">
            <TabItem Header="Zielliste / Außenanzeigen">
                <Grid Margin="0,8,0,0" MinHeight="420">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Liste (eigener Scrollbereich) -->
                    <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" Padding="12" UniformCornerRadius="12"
                                         Background="{StaticResource SmartSurfaceBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Zielliste"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="0,0,0,8" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ListBox ItemsSource="{Binding OutsidePrograms}"
                                         SelectedItem="{Binding SelectedOutsideProgram}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MinHeight="120">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ProtocolLabel}"
                                                           Opacity="0.65"
                                                           FontSize="11"
                                                           Margin="0,2,0,4" />
                                                <TextBlock FontSize="11" Opacity="0.9" TextWrapping="Wrap">
                                                    <Run Text="Front: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding FrontPreview, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" Opacity="0.9" TextWrapping="Wrap">
                                                    <Run Text="Seite: " FontWeight="SemiBold" />
                                                    <Run Text="{Binding SidePreview, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- Bearbeiten + Aktionen -->
                    <materialDesign:Card Grid.Column="1" Padding="14" UniformCornerRadius="12"
                                         Background="{StaticResource SmartSurfaceBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Zielanzeige bearbeiten"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="0,0,0,6" />
                            <TextBlock DockPanel.Dock="Top"
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       FontSize="11"
                                       Margin="0,0,0,10"
                                       Text="DS021T: Schleifenprogramm mit Intervall. DS003a Krefeld: 2×16 Zeichen Front/Seite, DS001, optional Steuerblock (12 Zeichen)." />

                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="+ DS021T"
                                            Command="{Binding AddOutsideProgramDs021tCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Margin="0,0,8,6" />
                                    <Button Content="+ DS003a Krefeld"
                                            Command="{Binding AddOutsideProgramKrefeldCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Margin="0,0,8,6" />
                                    <Button Content="Auswahl löschen"
                                            Command="{Binding RemoveOutsideProgramCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,8,6" />
                                    <Button Content="Speichern"
                                            Command="{Binding SaveCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Margin="0,0,0,6" />
                                </WrapPanel>
                            </StackPanel>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          MaxHeight="340">
                                <StackPanel DataContext="{Binding SelectedOutsideProgram}">
                                    <TextBlock Text="Links ein Ziel wählen oder unten neu anlegen."
                                               Opacity="0.7"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <CheckBox Grid.Row="0" Grid.ColumnSpan="2"
                                                  Content="Als Startziel (Name: Startziel)"
                                                  IsChecked="{Binding IsStartTarget, UpdateSourceTrigger=PropertyChanged}"
                                                  Margin="0,0,0,10" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Anzeigename" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Front Zeile 1" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding FrontLine1, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Front Zeile 2" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <TextBox Grid.Row="3" Grid.Column="1"
                                                 Text="{Binding FrontLine2, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Seite Zeile 1" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <TextBox Grid.Row="4" Grid.Column="1"
                                                 Text="{Binding SideLine1, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Seite Zeile 2" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <TextBox Grid.Row="5" Grid.Column="1"
                                                 Text="{Binding SideLine2, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="DS001 Typ" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <ComboBox Grid.Row="6" Grid.Column="1"
                                                  SelectedValue="{Binding Ds001Type}"
                                                  SelectedValuePath="Content"
                                                  Margin="0,0,0,8">
                                            <ComboBoxItem Content="line" />
                                            <ComboBoxItem Content="special" />
                                        </ComboBox>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="DS001 Wert" VerticalAlignment="Center" Margin="0,0,8,8" />
                                        <TextBox Grid.Row="7" Grid.Column="1"
                                                 Text="{Binding Ds001Value, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Intervall (Sek.)" VerticalAlignment="Center" Margin="0,0,8,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKrefeld}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Grid.Row="8" Grid.Column="1"
                                                 Text="{Binding IntervalSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKrefeld}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="DS001 Sonderz." VerticalAlignment="Center" Margin="0,0,8,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKrefeld}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Grid.Row="9" Grid.Column="1"
                                                 Text="{Binding Ds001Spec, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKrefeld}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Steuerblock" VerticalAlignment="Center" Margin="0,0,8,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKrefeld}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Grid.Row="10" Grid.Column="1"
                                                 materialDesign:HintAssist.Hint="leer = DG5DG7DG7DG7"
                                                 Text="{Binding ControlCodes, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,0,8">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKrefeld}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,4">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsKrefeld}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="zA4 / zA5:" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <CheckBox Content="zA4" IsChecked="{Binding UseZa4}" Margin="0,0,16,0" />
                                            <CheckBox Content="zA5" IsChecked="{Binding UseZa5}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <TabItem Header="Datumgesteuerte Hinweise">
                <Grid Margin="0,8,0,0" MinHeight="380">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:Card Grid.Column="0" Margin="0,0,10,0" Padding="12"
                                         Background="{StaticResource SmartSurfaceBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Hinweise" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding DateBasedHints}"
                                         SelectedItem="{Binding SelectedHint}"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding HintText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Opacity="0.7" FontSize="11">
                                                    <Run Text="{Binding StartDate, Mode=OneWay}" />
                                                    <Run Text=" – " />
                                                    <Run Text="{Binding EndDate, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </DockPanel>
                    </materialDesign:Card>
                    <materialDesign:Card Grid.Column="1" Padding="14" Background="{StaticResource SmartSurfaceBrush}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <TextBox materialDesign:HintAssist.Hint="Neuer Hinweistext"
                                         Text="{Binding NewHintText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Margin="0,0,6,0"
                                             materialDesign:HintAssist.Hint="Start TT.MM.JJJJ"
                                             Text="{Binding NewHintStartDate, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBox Grid.Column="1"
                                             materialDesign:HintAssist.Hint="Ende TT.MM.JJJJ"
                                             Text="{Binding NewHintEndDate, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Hinweis hinzufügen" Command="{Binding AddDateBasedHintCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0" />
                                    <Button Content="Auswahl löschen" Command="{Binding RemoveDateBasedHintCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                                    <Button Content="Speichern" Command="{Binding SaveCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" />
                                </WrapPanel>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="280">
                                <StackPanel DataContext="{Binding SelectedHint}">
                                    <TextBlock Text="Hinweis bearbeiten" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Text" Margin="0,0,8,8" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HintText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Start" Margin="0,0,8,8" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ende" Margin="0,0,8,8" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Bereits angezeigt (isShown)" IsChecked="{Binding IsShown}" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
