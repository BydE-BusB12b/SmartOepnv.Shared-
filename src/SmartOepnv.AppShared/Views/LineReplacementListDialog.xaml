<Window x:Class="SmartOepnv.AppShared.Views.LineReplacementListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Linienersatzliste"
        Width="720"
        Height="560"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartBackgroundBrush}"
        Foreground="{DynamicResource SmartForegroundBrush}"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"
                   Text="Die App ersetzt bei IBIS-IP die Linie vor dem Schrägstrich. 001 bis 099 und RE1 bis RE99 ergibt aus 047 den Text RE47. Für eine einzelne Linie nur die linken Felder füllen, zum Beispiel 604 und RE4." />

        <ListBox x:Name="RuleList"
                 Grid.Row="1"
                 DisplayMemberPath="ListTitle"
                 Background="{StaticResource SmartSurfaceBrush}"
                 BorderBrush="#42A5F5"
                 Foreground="{DynamicResource SmartForegroundBrush}" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="FromLineBox"
                     Grid.Row="0"
                     Grid.Column="0"
                     Margin="0,0,8,8"
                     materialDesign:HintAssist.Hint="Linie von"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            <TextBox x:Name="ToLineBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,0,8,8"
                     materialDesign:HintAssist.Hint="Linie bis"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            <TextBox x:Name="FromDisplayBox"
                     Grid.Row="0"
                     Grid.Column="2"
                     Margin="0,0,8,8"
                     materialDesign:HintAssist.Hint="Ersatz von"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            <TextBox x:Name="ToDisplayBox"
                     Grid.Row="0"
                     Grid.Column="3"
                     Margin="0,0,8,8"
                     materialDesign:HintAssist.Hint="Ersatz bis"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal">
                <Button Content="Eintragen"
                        Click="AddButton_Click"
                        Margin="0,0,8,8"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button Content="Löschen"
                        Click="DeleteButton_Click"
                        Margin="0,0,0,8"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StackPanel>
            <TextBlock x:Name="ErrorText"
                       Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="5"
                       Foreground="#E53935"
                       TextWrapping="Wrap" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Abbrechen"
                    IsCancel="True"
                    Margin="0,0,8,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            <Button Content="Übernehmen"
                    IsDefault="True"
                    Click="OkButton_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</Window>
