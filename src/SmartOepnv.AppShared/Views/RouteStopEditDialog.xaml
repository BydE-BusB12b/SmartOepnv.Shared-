<Window x:Class="SmartOepnv.AppShared.Views.RouteStopEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartOepnv.AppShared.Views"
        Title="Haltestelle bearbeiten"
        Width="640"
        MinWidth="600"
        Height="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartPrimaryDarkBrush}"
        Foreground="White"
        ResizeMode="CanResize">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Abbrechen" MinWidth="100" MinHeight="36" Margin="0,0,8,0"
                    IsCancel="True" Click="CancelButton_Click"
                    Background="#1E5A9E" Foreground="White" BorderBrush="#42A5F5" />
            <Button x:Name="SaveButton" Content="Speichern" MinWidth="110" MinHeight="36"
                    IsDefault="True" Click="SaveButton_Click"
                    Background="#0D47A1" Foreground="White" BorderBrush="#42A5F5" />
        </StackPanel>
        <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,12" TextWrapping="Wrap" />
        <ScrollViewer x:Name="EditorScroll"
                      VerticalScrollBarVisibility="Visible"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SmartDarkComboBoxScrollBar}" />
            </ScrollViewer.Resources>
            <local:RouteStopEditPanel x:Name="EditPanel"
                                      HorizontalAlignment="Stretch" />
        </ScrollViewer>
    </DockPanel>
</Window>
