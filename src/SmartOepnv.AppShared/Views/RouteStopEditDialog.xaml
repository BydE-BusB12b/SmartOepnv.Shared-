<Window x:Class="SmartOepnv.AppShared.Views.RouteStopEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SmartOepnv.AppShared.Views"
        Title="Haltestelle bearbeiten"
        Width="1100"
        MinWidth="720"
        Height="700"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartPrimaryDarkBrush}"
        Foreground="White"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,12" TextWrapping="Wrap" />
        <ScrollViewer x:Name="EditorScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource SmartDarkComboBoxScrollBar}" />
            </ScrollViewer.Resources>
            <local:RouteStopEditPanel x:Name="EditPanel"
                                      HorizontalAlignment="Stretch" />
        </ScrollViewer>
        <Border Grid.Row="2"
                Background="{StaticResource SmartPrimaryDarkBrush}"
                Padding="0,12,0,0"
                Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Abbrechen" MinWidth="100" MinHeight="36" Margin="0,0,8,0"
                        IsCancel="True" Click="CancelButton_Click"
                        Background="#1E5A9E" Foreground="White" BorderBrush="#42A5F5" />
                <Button x:Name="SaveButton" Content="Speichern" MinWidth="110" MinHeight="36"
                        IsDefault="True" Click="SaveButton_Click"
                        Background="#0D47A1" Foreground="White" BorderBrush="#42A5F5" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
