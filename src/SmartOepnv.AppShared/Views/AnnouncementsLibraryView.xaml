<UserControl x:Class="SmartOepnv.AppShared.Views.AnnouncementsLibraryView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

             VerticalAlignment="Stretch"

             HorizontalAlignment="Stretch">

    <Grid Margin="0,0,0,8">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="340" />

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>



        <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="12"

                             Background="{StaticResource SmartSurfaceBrush}"

                             VerticalAlignment="Stretch">

            <!-- DockPanel: Buttons unten immer sichtbar (wie Haltestellenbibliothek) -->

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="Ansagen-Kartei"

                               FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />

                    <TextBlock Text="Jede Ansage hat eine 4-stellige ID. Beschreibung z. B. „Endhaltestelle“.&#10;✓ Ton zugeordnet   ·   ⚠ noch keine Tondatei"

                               Opacity="0.65" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <TextBox materialDesign:HintAssist.Hint="Suchen (Ansagen-ID, Bezeichnung, Beschreibung)"

                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"

                             Margin="0,0,0,10" />

                </StackPanel>



                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">

                    <Button Content="Speichern &amp; JSON"

                            Command="{Binding SaveChangesCommand}"

                            Style="{StaticResource MaterialDesignRaisedButton}"

                            Margin="0,0,0,6"

                            Padding="10,6"

                            ToolTip="Schreibt Ansagen und Tondateien ins routes_export.json – danach unter Übersicht/Datenübertragung nach Dropbox exportieren" />

                    <Button Content="Neue Ansage mit Tondatei"

                            Command="{Binding AddAnnouncementWithAudioCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="0,0,0,4"

                            Padding="10,4" />

                    <Button Content="Neue Ansage (ohne Ton)"

                            Command="{Binding AddAnnouncementCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="0,0,0,4"

                            Padding="10,4" />

                    <Button Content="Ansage duplizieren"

                            Command="{Binding DuplicateAnnouncementCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="0,0,0,4"

                            Padding="10,4" />

                    <Button Content="Ansage löschen"

                            Command="{Binding RemoveAnnouncementCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Padding="10,4" />

                </StackPanel>



                <ListBox ItemsSource="{Binding FilteredAnnouncements}"

                         SelectedItem="{Binding SelectedAnnouncement}"

                         DisplayMemberPath="DisplayLabel"

                         BorderThickness="1"

                         BorderBrush="#334155"

                         Background="Transparent"

                         ScrollViewer.VerticalScrollBarVisibility="Auto"

                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                         MinHeight="120" />

            </DockPanel>

        </materialDesign:Card>



        <materialDesign:Card Grid.Column="1" Padding="16" UniformCornerRadius="12"

                             Background="{StaticResource SmartSurfaceBrush}"

                             VerticalAlignment="Stretch">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Ansage bearbeiten"

                               FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />



                    <TextBlock DockPanel.Dock="Bottom"

                               Text="{Binding StatusMessage}"

                               Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />



                    <StackPanel>

                        <TextBlock Text="Links eine Ansage wählen oder „Neue Ansage“ anlegen."

                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding SelectedAnnouncement}" Value="{x:Null}">

                                            <Setter Property="Visibility" Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>



                        <Grid DataContext="{Binding SelectedAnnouncement}">

                            <Grid.Style>

                                <Style TargetType="Grid">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Grid.Style>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>



                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ansagen-ID (4 Ziffern):"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" MinWidth="180" />

                            <TextBox Grid.Row="0" Grid.Column="1"

                                     Text="{Binding AnnouncementCode, UpdateSourceTrigger=PropertyChanged}"

                                     MaxLength="4" Margin="0,0,0,10" />



                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bezeichnung:"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" />

                            <TextBox Grid.Row="1" Grid.Column="1"

                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"

                                     Margin="0,0,0,10" />



                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Kategorie:"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" />

                            <ComboBox Grid.Row="2" Grid.Column="1"

                                      ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                      SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"

                                      Margin="0,0,0,10" />



                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Beschreibung:"

                                       VerticalAlignment="Top" Margin="0,4,12,10" Opacity="0.9" />

                            <TextBox Grid.Row="3" Grid.Column="1"

                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"

                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"

                                     Margin="0,0,0,10" />



                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Sonderansagen:"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" />

                            <CheckBox Grid.Row="4" Grid.Column="1"

                                      Content="In Sonderansagen anzeigen (ITCS / Handy-Liste)"

                                      IsChecked="{Binding IncludeInSpecialAnnouncements, UpdateSourceTrigger=PropertyChanged}"

                                      Margin="0,0,0,10" />



                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Eingebetteter Ton:"

                                       VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.9" />

                            <TextBox Grid.Row="5" Grid.Column="1"

                                     Text="{Binding EmbeddedSoundFileName, UpdateSourceTrigger=PropertyChanged}" />

                        </Grid>



                        <TextBlock Text="{Binding SelectedAnnouncementAudioHint}"

                                   Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="11" FontStyle="Italic" />



                        <materialDesign:Card Padding="12" UniformCornerRadius="8"

                                             Background="{StaticResource SmartPrimaryDarkBrush}"

                                             Margin="0,16,0,0">

                            <StackPanel>

                                <TextBlock Text="Ton &amp; Import" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <Button Content="Speichern &amp; JSON"

                                        Command="{Binding SaveChangesCommand}"

                                        Style="{StaticResource MaterialDesignRaisedButton}"

                                        Margin="0,0,0,10"

                                        Padding="12,6"

                                        ToolTip="Pflicht nach Tondatei wählen: schreibt ins routes_export.json" />

                                <Button Content="Tondatei wählen…"

                                        Command="{Binding PickAudioFileCommand}"

                                        Style="{StaticResource MaterialDesignRaisedLightButton}"

                                        Margin="0,0,0,8" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Pause zwischen Schnipseln (Sek.):"
                                               Foreground="White"
                                               VerticalAlignment="Center"
                                               Opacity="0.9"
                                               Margin="0,0,8,0"
                                               FontSize="12" />
                                    <TextBox Text="{Binding AnnouncementMergePauseSeconds, UpdateSourceTrigger=PropertyChanged}"
                                             Width="72"
                                             Padding="6,4"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Stille zwischen den Ansagen, z. B. 0,3 – 0 = keine Pause" />
                                </StackPanel>

                                <Button Content="Mehrere zusammenfügen…"

                                        Command="{Binding MergeEmbeddedSoundsFromListCommand}"

                                        Style="{StaticResource MaterialDesignRaisedLightButton}"

                                        Margin="0,0,0,8"

                                        ToolTip="Mehrere Ansagen nacheinander zu einer WAV-Datei zusammenfügen" />

                                <Button Content="Aus Routen importieren"

                                        Command="{Binding ImportFromRoutesCommand}"

                                        Style="{StaticResource MaterialDesignOutlinedButton}"

                                        Margin="0,0,0,6" />

                                <Button Content="Aus embeddedSounds importieren"

                                        Command="{Binding ImportFromEmbeddedSoundsListCommand}"

                                        Style="{StaticResource MaterialDesignOutlinedButton}" />

                            </StackPanel>

                        </materialDesign:Card>

                    </StackPanel>

                </DockPanel>

            </ScrollViewer>

        </materialDesign:Card>

    </Grid>

</UserControl>
