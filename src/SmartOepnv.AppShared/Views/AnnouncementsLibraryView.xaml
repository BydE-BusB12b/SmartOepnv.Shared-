<UserControl x:Class="SmartOepnv.AppShared.Views.AnnouncementsLibraryView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

             VerticalAlignment="Stretch"

             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="AnnouncementSaveJsonButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SaveJsonButtonIsSuccess}" Value="True">
                    <Setter Property="Background" Value="#FF4CAF50" />
                    <Setter Property="BorderBrush" Value="#FF4CAF50" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MergedAnnouncementListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMergedAnnouncement}" Value="True">
                    <Setter Property="Background" Value="#4DFFEB3B" />
                    <Setter Property="BorderBrush" Value="#99FFEB3B" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <TabControl Margin="0,2,0,4" VerticalAlignment="Stretch"
                SelectedIndex="{Binding SelectedLibraryTabIndex}">
        <TabItem Header="Kartei">
    <!-- Kein äußerer ScrollViewer: Kartei-Liste scrollt separat in der linken Spalte -->
    <Grid Margin="0" VerticalAlignment="Stretch">

        <Grid.ColumnDefinitions>

                <ColumnDefinition Width="340" />

                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>



        <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="12"

                             Background="{StaticResource SmartSurfaceBrush}"

                             VerticalAlignment="Stretch">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="Ansagen-Kartei"

                               FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />

                    <TextBox materialDesign:HintAssist.Hint="Suchen (Ansagen-ID, Bezeichnung, Beschreibung, Linie)"

                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"

                             Margin="0,0,0,6" />

                    <TextBlock Text="✓ Ton zugeordnet   ·   ⚠ keine Tondatei   ·   Gelb = Zusammenfüge-Ansage (_zusammen)"
                               Opacity="0.65"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6" />

                </StackPanel>



                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">

                    <Button Content="Speichern &amp; JSON"

                            Command="{Binding SaveChangesCommand}"

                            Style="{StaticResource AnnouncementSaveJsonButtonStyle}"

                            Margin="0,0,0,6"

                            Padding="10,6" />

                    <Button Content="Sounddatei Update"

                            Command="{Binding SoundFileUpdateCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="0,0,0,4"

                            Padding="10,4" />

                    <Button Content="Duplikate prüfen"

                            Command="{Binding CheckDuplicateAnnouncementsCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="0,0,0,4"

                            Padding="10,4" />

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"

                            Content="Neue Ansage"

                            Command="{Binding AddAnnouncementWithAudioCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="0,0,4,0"

                            Padding="10,4" />

                    <Button Grid.Column="1"

                            Content="Ansage löschen"

                            Command="{Binding RemoveAnnouncementCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="4,0,0,0"

                            Padding="10,4" />

                    </Grid>

                </StackPanel>



                <ListBox ItemsSource="{Binding FilteredAnnouncements}"

                         SelectedItem="{Binding SelectedAnnouncement}"

                         ItemContainerStyle="{StaticResource MergedAnnouncementListBoxItemStyle}"

                         BorderThickness="1"

                         BorderBrush="#334155"

                         Background="Transparent"

                         Margin="0,2,0,0"

                         ScrollViewer.VerticalScrollBarVisibility="Auto"

                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                         ScrollViewer.CanContentScroll="False"

                         VirtualizingPanel.IsVirtualizing="True"

                         VirtualizingPanel.VirtualizationMode="Recycling">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <TextBlock Text="{Binding DisplayLabel}"

                                       TextWrapping="Wrap"

                                       FontSize="12"

                                       LineHeight="16" />

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </DockPanel>

        </materialDesign:Card>



        <materialDesign:Card Grid.Column="1" Padding="16" UniformCornerRadius="12"

                             Background="{StaticResource SmartSurfaceBrush}"

                             VerticalAlignment="Stretch">

                <DockPanel LastChildFill="True">

                    <TextBlock DockPanel.Dock="Top" Text="Ansage bearbeiten"

                               FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />



                    <TextBlock DockPanel.Dock="Bottom"

                               Text="{Binding StatusMessage}"

                               Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />



                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">

                    <StackPanel>

                        <TextBlock Text="Links eine Ansage wählen oder „Neue Ansage“ anlegen."

                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding SelectedAnnouncement}" Value="{x:Null}">

                                            <Setter Property="Visibility" Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>



                        <Grid DataContext="{Binding SelectedAnnouncement}">

                            <Grid.Style>

                                <Style TargetType="Grid">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Grid.Style>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>



                            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="72" />

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" MinWidth="100" />

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="Auto" MinWidth="110" />

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Ansagen-ID:"

                                           VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9" />

                                <TextBox Grid.Column="1"

                                         Text="{Binding AnnouncementCode, UpdateSourceTrigger=PropertyChanged}"

                                         MaxLength="4" Margin="0,0,12,0" />

                                <TextBlock Grid.Column="2" Text="Bezeichnung:"

                                           VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9" />

                                <TextBox Grid.Column="3"

                                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"

                                         Margin="0,0,12,0" />

                                <TextBlock Grid.Column="4" Text="Kategorie:"

                                           VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9" />

                                <ComboBox Grid.Column="5"

                                          ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                          SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"

                                          MinWidth="110" />

                            </Grid>



                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" MinWidth="120" />

                                    <ColumnDefinition Width="12" />

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" MinWidth="160" />

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Beschreibung:"

                                           VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9" />

                                <TextBox Grid.Column="1"

                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"

                                         VerticalAlignment="Center" />

                                <TextBlock Grid.Column="3" Text="Linien:"

                                           VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.9" />

                                <TextBox Grid.Column="4"

                                         Text="{Binding Lines, UpdateSourceTrigger=PropertyChanged}"

                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40"

                                         materialDesign:HintAssist.Hint="z. B. SB19, NE4, 682 (kommagetrennt)"
                                         VerticalAlignment="Center" />

                            </Grid>



                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Sonderansagen:"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" />

                            <CheckBox Grid.Row="2" Grid.Column="1"

                                      Content="In Sonderansagen anzeigen (ITCS / Handy-Liste)"

                                      IsChecked="{Binding IncludeInSpecialAnnouncements, UpdateSourceTrigger=PropertyChanged}"

                                      Margin="0,0,0,10" />



                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Lautsprecher:"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" />

                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">

                                <Button MinWidth="100"

                                        Padding="12,4"

                                        Content="{Binding AudioOutputLabel}"

                                        ToolTip="Klick: Innen → Außen → Beide (Stereo L/R am Tablet)"

                                        Click="CycleAudioOutput_OnClick" />

                                <TextBlock Text="Klick wechselt Innen / Außen / Beide"

                                           VerticalAlignment="Center"

                                           Margin="12,0,0,0"

                                           Opacity="0.7"

                                           FontSize="12" />

                            </StackPanel>



                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Eingebetteter Ton:"

                                       VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.9" />

                            <Grid Grid.Row="4" Grid.Column="1">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"

                                         Text="{Binding DataContext.SelectedEmbeddedSoundFileName, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"

                                         IsReadOnly="True" Opacity="0.85" />

                                <Button Grid.Column="1"

                                        Content="✕"

                                        Command="{Binding DataContext.ClearEmbeddedSoundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                        Padding="0"

                                        Width="28"

                                        Height="28"

                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center" />

                            </Grid>

                        </Grid>



                        <TextBlock Text="{Binding SelectedAnnouncementAudioHint}"

                                   Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="11" FontStyle="Italic" />



                        <materialDesign:Card Padding="12" UniformCornerRadius="8"

                                             Background="{StaticResource SmartPrimaryDarkBrush}"

                                             Margin="0,16,0,0">

                            <StackPanel>

                                <TextBlock Text="Ton &amp; Import" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="12" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"

                                              Content="Gong"

                                              IsChecked="{Binding IncludeGongInAnnouncementMerge, UpdateSourceTrigger=PropertyChanged}"

                                              Foreground="White" />

                                    <CheckBox Grid.Column="2"

                                              Content="Sondergong"

                                              IsChecked="{Binding IncludeSondergongInAnnouncementMerge, UpdateSourceTrigger=PropertyChanged}"

                                              Foreground="White" />

                                </Grid>

                                <Grid Margin="0,0,0,8">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="12" />

                                        <ColumnDefinition Width="*" />

                                        <ColumnDefinition Width="12" />

                                        <ColumnDefinition Width="*" />

                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"

                                              Content="Nächste Haltestelle einfügen"

                                              IsChecked="{Binding IncludeNextStopInAnnouncementMerge, UpdateSourceTrigger=PropertyChanged}"

                                              Foreground="White" />

                                    <CheckBox Grid.Column="2"

                                              Content="Next Stop einfügen"

                                              IsChecked="{Binding IncludeNextStopMp3InAnnouncementMerge, UpdateSourceTrigger=PropertyChanged}"

                                              Foreground="White" />

                                    <CheckBox Grid.Column="4"

                                              Content="Folgende Halte einfügen"

                                              IsChecked="{Binding IncludeFollowingStopsInAnnouncementMerge, UpdateSourceTrigger=PropertyChanged}"

                                              Foreground="White" />

                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                    <TextBlock Text="Standard-Pause (Sek.):"

                                               Foreground="White"

                                               VerticalAlignment="Center"

                                               Opacity="0.9"

                                               Margin="0,0,8,0"

                                               FontSize="12" />

                                    <ComboBox IsEditable="True"

                                              ItemsSource="{Binding AnnouncementMergePausePresets}"

                                              Text="{Binding AnnouncementMergePauseSeconds, UpdateSourceTrigger=PropertyChanged}"

                                              Width="88"

                                              Padding="6,4"

                                              VerticalContentAlignment="Center" />

                                </StackPanel>

                                <StackPanel Margin="0,0,0,10">

                                    <Grid Margin="0,0,0,8">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="8" />

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="8" />

                                            <ColumnDefinition Width="*" />

                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"

                                                Content="Speichern &amp; JSON"

                                                Command="{Binding SaveChangesCommand}"

                                                Style="{StaticResource AnnouncementSaveJsonButtonStyle}"

                                                Padding="8,6" />

                                        <Button Grid.Column="2"

                                                Content="Pause einfügen"

                                                Command="{Binding AddPauseToSequenceCommand}"

                                                Style="{StaticResource MaterialDesignOutlinedButton}"

                                                Foreground="White"

                                                Padding="8,6" />

                                        <Button Grid.Column="4"

                                                Content="Begrüßung Linie/Ziel"

                                                Command="{Binding AddGreetingLineDestinationPackageCommand}"

                                                Style="{StaticResource MaterialDesignOutlinedButton}"

                                                Foreground="White"

                                                Padding="8,6" />

                                    </Grid>

                                    <Grid>

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="8" />

                                            <ColumnDefinition Width="*" />

                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"

                                                Content="{Binding PickAudioButtonLabel}"

                                                Command="{Binding PickAudioFileCommand}"

                                                Style="{StaticResource MaterialDesignRaisedLightButton}"

                                                Padding="8,6" />

                                        <Button Grid.Column="2"

                                                Content="Vorschau abspielen"

                                                Command="{Binding PlayAnnouncementPreviewCommand}"

                                                Style="{StaticResource MaterialDesignRaisedLightButton}"

                                                Padding="8,6" />

                                    </Grid>

                                </StackPanel>

                                <TextBlock Text="Tonsequenz (Reihenfolge)"

                                           Foreground="White"

                                           Opacity="0.9"

                                           FontSize="12"

                                           Margin="0,0,0,4" />

                                <ListBox ItemsSource="{Binding AnnouncementSequence}"

                                         SelectedItem="{Binding SelectedSequenceItem}"

                                         DisplayMemberPath="ListLabel"

                                         MinHeight="88"

                                         MaxHeight="180"

                                         Margin="0,0,0,8"

                                         BorderThickness="1"

                                         BorderBrush="#475569"

                                         Background="#1E293B" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                                    <Button Content="↑"

                                            Command="{Binding MoveSequenceItemUpCommand}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Foreground="White"

                                            MinWidth="36"

                                            Margin="0,0,6,0" />

                                    <Button Content="↓"

                                            Command="{Binding MoveSequenceItemDownCommand}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Foreground="White"

                                            MinWidth="36"

                                            Margin="0,0,6,0" />

                                    <Button Content="Ersetzen"

                                            Command="{Binding ReplaceSequenceItemCommand}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Foreground="White"

                                            MinWidth="72"

                                            Margin="0,0,6,0" />

                                    <Button Content="Löschen"

                                            Command="{Binding RemoveSequenceItemCommand}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Foreground="White"

                                            MinWidth="72" />

                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">

                                    <StackPanel.Style>

                                        <Style TargetType="StackPanel">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding HasSelectedSequencePauseItem}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </StackPanel.Style>

                                    <TextBlock Text="Pause (Sek.):" Foreground="White" Opacity="0.9" FontSize="12" Margin="0,0,0,4" />

                                    <TextBox Text="{Binding SelectedSequenceItem.PauseSeconds, UpdateSourceTrigger=PropertyChanged}"

                                             Width="88"

                                             Padding="6,4"

                                             HorizontalAlignment="Left" />

                                </StackPanel>

                            </StackPanel>

                        </materialDesign:Card>

                    </StackPanel>

                    </ScrollViewer>

                </DockPanel>

        </materialDesign:Card>

        </Grid>
        </TabItem>

        <TabItem Header="Spezialbausteine">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="12"
                                     Background="{StaticResource SmartSurfaceBrush}" VerticalAlignment="Stretch">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Spezialbausteine" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                            <TextBlock Text="Feste Bausteine + Linien aus Routen. Fehlende Töne über „Ton hinzufügen…“ – ohne Haltestellenansage."
                                       Opacity="0.65" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SpecialBuildingBlocksSummary}" Opacity="0.85" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="Ton hinzufügen…" Command="{Binding AddLineSpecialBuildingBlockCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,0,4" Padding="10,4" />
                            <Button Content="Aus Liste entfernen" Command="{Binding RemoveSelectedSpecialBuildingBlockCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,4" Padding="10,4"
                                    IsEnabled="{Binding CanRemoveSelectedSpecialBuildingBlock}" />
                            <Button Content="Liste aktualisieren" Command="{Binding RefreshSpecialBuildingBlocksListCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,4" Padding="10,4" />
                            <Button Content="Vorhandene in embeddedSounds übernehmen" Command="{Binding StageAllPresentSpecialBuildingBlocksCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,4" Padding="10,4" />
                            <Button Content="Ordner Rohdateien öffnen" Command="{Binding OpenRawSoundsFolderCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,4" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SpecialBuildingBlocks}" SelectedItem="{Binding SelectedSpecialBuildingBlock}"
                                 BorderThickness="1" BorderBrush="#334155" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Description}" FontSize="10" Opacity="0.6" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="1" Padding="16" UniformCornerRadius="12"
                                     Background="{StaticResource SmartSurfaceBrush}" VerticalAlignment="Stretch">
                    <StackPanel DataContext="{Binding SelectedSpecialBuildingBlock}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Baustein bearbeiten" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />
                        <TextBlock Text="Bezeichnung" Opacity="0.7" FontSize="11" />
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Dateiname (fest)" Opacity="0.7" FontSize="11" />
                        <TextBlock Text="{Binding FileName}" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="Status" Opacity="0.7" FontSize="11" />
                        <TextBlock Text="{Binding StatusLabel}" FontSize="14" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,16" />
                        <Button Content="Tondatei zuweisen…"
                                Command="{Binding DataContext.AssignSpecialBuildingBlockFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,0,8" Padding="10,6" />
                        <Button Content="Anhören"
                                Command="{Binding DataContext.PlaySpecialBuildingBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,8" Padding="10,6" />
                        <Button Content="Im Explorer zeigen"
                                Command="{Binding DataContext.RevealSpecialBuildingBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,6" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </TabItem>

    </TabControl>

</UserControl>
