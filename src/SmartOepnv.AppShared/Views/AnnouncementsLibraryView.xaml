<UserControl x:Class="SmartOepnv.AppShared.Views.AnnouncementsLibraryView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

             VerticalAlignment="Stretch"

             HorizontalAlignment="Stretch">

    <Grid Margin="0,0,0,8">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="340" />

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>



        <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16" UniformCornerRadius="12"

                             Background="{StaticResource SmartSurfaceBrush}"

                             VerticalAlignment="Stretch">

            <!-- DockPanel: Buttons unten immer sichtbar (wie Haltestellenbibliothek) -->

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top">

                    <TextBlock Text="Ansagen-Kartei"

                               FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />

                    <TextBlock Text="Jede Ansage hat eine 4-stellige ID. Beschreibung z. B. „Endhaltestelle“.&#10;✓ Ton zugeordnet   ·   ⚠ noch keine Tondatei"

                               Opacity="0.65" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />

                    <TextBox materialDesign:HintAssist.Hint="Suchen (Ansagen-ID, Bezeichnung, Beschreibung)"

                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"

                             Margin="0,0,0,10" />

                </StackPanel>



                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">

                    <Button Content="Speichern &amp; JSON"

                            Command="{Binding SaveChangesCommand}"

                            Style="{StaticResource MaterialDesignRaisedButton}"

                            Margin="0,0,0,6"

                            Padding="10,6"

                            ToolTip="Fügt Tonsequenz zusammen und schreibt Ansagen ins routes_export.json" />

                    <Button Content="Neue Ansage mit Tondatei"

                            Command="{Binding AddAnnouncementWithAudioCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="0,0,0,4"

                            Padding="10,4" />

                    <Button Content="Neue Ansage (ohne Ton)"

                            Command="{Binding AddAnnouncementCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="0,0,0,4"

                            Padding="10,4" />

                    <Button Content="Ansage duplizieren"

                            Command="{Binding DuplicateAnnouncementCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Margin="0,0,0,4"

                            Padding="10,4" />

                    <Button Content="Ansage löschen"

                            Command="{Binding RemoveAnnouncementCommand}"

                            Style="{StaticResource MaterialDesignOutlinedButton}"

                            Padding="10,4" />

                </StackPanel>



                <ListBox ItemsSource="{Binding FilteredAnnouncements}"

                         SelectedItem="{Binding SelectedAnnouncement}"

                         DisplayMemberPath="DisplayLabel"

                         BorderThickness="1"

                         BorderBrush="#334155"

                         Background="Transparent"

                         ScrollViewer.VerticalScrollBarVisibility="Auto"

                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"

                         MinHeight="120" />

            </DockPanel>

        </materialDesign:Card>



        <materialDesign:Card Grid.Column="1" Padding="16" UniformCornerRadius="12"

                             Background="{StaticResource SmartSurfaceBrush}"

                             VerticalAlignment="Stretch">

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                <DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="Ansage bearbeiten"

                               FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12" />



                    <TextBlock DockPanel.Dock="Bottom"

                               Text="{Binding StatusMessage}"

                               Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.85" FontSize="12" />



                    <StackPanel>

                        <TextBlock Text="Links eine Ansage wählen oder „Neue Ansage“ anlegen."

                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility" Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding SelectedAnnouncement}" Value="{x:Null}">

                                            <Setter Property="Visibility" Value="Visible" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>



                        <Grid DataContext="{Binding SelectedAnnouncement}">

                            <Grid.Style>

                                <Style TargetType="Grid">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Grid.Style>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto" />

                                <ColumnDefinition Width="*" />

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                                <RowDefinition Height="Auto" />

                            </Grid.RowDefinitions>



                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ansagen-ID (4 Ziffern):"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" MinWidth="180" />

                            <TextBox Grid.Row="0" Grid.Column="1"

                                     Text="{Binding AnnouncementCode, UpdateSourceTrigger=PropertyChanged}"

                                     MaxLength="4" Margin="0,0,0,10" />



                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bezeichnung:"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" />

                            <TextBox Grid.Row="1" Grid.Column="1"

                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"

                                     Margin="0,0,0,10" />



                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Kategorie:"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" />

                            <ComboBox Grid.Row="2" Grid.Column="1"

                                      ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                      SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"

                                      Margin="0,0,0,10" />



                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Beschreibung:"

                                       VerticalAlignment="Top" Margin="0,4,12,10" Opacity="0.9" />

                            <TextBox Grid.Row="3" Grid.Column="1"

                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"

                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"

                                     Margin="0,0,0,10" />



                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Sonderansagen:"

                                       VerticalAlignment="Center" Margin="0,0,12,10" Opacity="0.9" />

                            <CheckBox Grid.Row="4" Grid.Column="1"

                                      Content="In Sonderansagen anzeigen (ITCS / Handy-Liste)"

                                      IsChecked="{Binding IncludeInSpecialAnnouncements, UpdateSourceTrigger=PropertyChanged}"

                                      Margin="0,0,0,10" />



                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Eingebetteter Ton:"

                                       VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.9" />

                            <TextBox Grid.Row="5" Grid.Column="1"

                                     Text="{Binding EmbeddedSoundFileName, UpdateSourceTrigger=PropertyChanged}"

                                     IsReadOnly="True" Opacity="0.85"

                                     ToolTip="Wird beim Speichern aus der Sequenz erzeugt" />

                        </Grid>



                        <TextBlock Text="{Binding SelectedAnnouncementAudioHint}"

                                   Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.7" FontSize="11" FontStyle="Italic" />



                        <materialDesign:Card Padding="12" UniformCornerRadius="8"

                                             Background="{StaticResource SmartPrimaryDarkBrush}"

                                             Margin="0,16,0,0">

                            <StackPanel>

                                <TextBlock Text="Ton &amp; Import" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <Button Content="Speichern &amp; JSON"

                                        Command="{Binding SaveChangesCommand}"

                                        Style="{StaticResource MaterialDesignRaisedButton}"

                                        Margin="0,0,0,10"

                                        Padding="12,6"

                                        ToolTip="Sequenz zusammenfügen und ins routes_export.json schreiben" />

                                <CheckBox Content="Gong"

                                          IsChecked="{Binding IncludeGongInAnnouncementMerge, UpdateSourceTrigger=PropertyChanged}"

                                          Foreground="White"

                                          Margin="0,0,0,8"

                                          ToolTip="Hambloch Gong.wav vor die Sequenz setzen" />

                                <CheckBox Content="Nächste Haltestelle einfügen"

                                          IsChecked="{Binding IncludeNextStopInAnnouncementMerge, UpdateSourceTrigger=PropertyChanged}"

                                          Foreground="White"

                                          Margin="0,0,0,8"

                                          ToolTip="Nächste Haltestelle.wav nach dem Gong (1 s Pause dazwischen)" />

                                <CheckBox Content="Next Stop einfügen"

                                          IsChecked="{Binding IncludeNextStopMp3InAnnouncementMerge, UpdateSourceTrigger=PropertyChanged}"

                                          Foreground="White"

                                          Margin="0,0,0,8"

                                          ToolTip="Next Stop.mp3 nach Nächste Haltestelle (1 s Pause dazwischen)" />

                                <CheckBox Content="Endhaltestelle einfügen"

                                          IsChecked="{Binding IncludeEndStopInAnnouncementMerge, UpdateSourceTrigger=PropertyChanged}"

                                          Foreground="White"

                                          Margin="0,0,0,8"

                                          ToolTip="Endhalestelle.wav am Ende der Sequenz (Dropbox/Ansagen)" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                                    <TextBlock Text="Standard-Pause (Sek.):"

                                               Foreground="White"

                                               VerticalAlignment="Center"

                                               Opacity="0.9"

                                               Margin="0,0,8,0"

                                               FontSize="12" />

                                    <ComboBox IsEditable="True"

                                              ItemsSource="{Binding AnnouncementMergePausePresets}"

                                              Text="{Binding AnnouncementMergePauseSeconds, UpdateSourceTrigger=PropertyChanged}"

                                              Width="88"

                                              Padding="6,4"

                                              VerticalContentAlignment="Center"

                                              ToolTip="Wird beim Hinzufügen weiterer Tondateien automatisch eingefügt" />

                                </StackPanel>

                                <Button Content="{Binding PickAudioButtonLabel}"

                                        Command="{Binding PickAudioFileCommand}"

                                        Style="{StaticResource MaterialDesignRaisedLightButton}"

                                        Margin="0,0,0,8" />

                                <Button Content="Pause einfügen"

                                        Command="{Binding AddPauseToSequenceCommand}"

                                        Style="{StaticResource MaterialDesignOutlinedButton}"

                                        Foreground="White"

                                        Margin="0,0,0,8" />

                                <TextBlock Text="Tonsequenz (Reihenfolge)"

                                           Foreground="White"

                                           Opacity="0.9"

                                           FontSize="12"

                                           Margin="0,0,0,4" />

                                <ListBox ItemsSource="{Binding AnnouncementSequence}"

                                         SelectedItem="{Binding SelectedSequenceItem}"

                                         DisplayMemberPath="ListLabel"

                                         MinHeight="88"

                                         MaxHeight="180"

                                         Margin="0,0,0,8"

                                         BorderThickness="1"

                                         BorderBrush="#475569"

                                         Background="#1E293B" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                                    <Button Content="↑"

                                            Command="{Binding MoveSequenceItemUpCommand}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Foreground="White"

                                            MinWidth="36"

                                            Margin="0,0,6,0"

                                            ToolTip="Nach oben" />

                                    <Button Content="↓"

                                            Command="{Binding MoveSequenceItemDownCommand}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Foreground="White"

                                            MinWidth="36"

                                            Margin="0,0,6,0"

                                            ToolTip="Nach unten" />

                                    <Button Content="Ersetzen"

                                            Command="{Binding ReplaceSequenceItemCommand}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Foreground="White"

                                            MinWidth="72"

                                            Margin="0,0,6,0"

                                            ToolTip="Tondatei ersetzen" />

                                    <Button Content="Löschen"

                                            Command="{Binding RemoveSequenceItemCommand}"

                                            Style="{StaticResource MaterialDesignOutlinedButton}"

                                            Foreground="White"

                                            MinWidth="72"

                                            ToolTip="Eintrag entfernen" />

                                </StackPanel>

                                <StackPanel Margin="0,0,0,8">

                                    <StackPanel.Style>

                                        <Style TargetType="StackPanel">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding HasSelectedSequencePauseItem}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </StackPanel.Style>

                                    <TextBlock Text="Pause (Sek.):" Foreground="White" Opacity="0.9" FontSize="12" Margin="0,0,0,4" />

                                    <TextBox Text="{Binding SelectedSequenceItem.PauseSeconds, UpdateSourceTrigger=PropertyChanged}"

                                             Width="88"

                                             Padding="6,4"

                                             HorizontalAlignment="Left" />

                                </StackPanel>

                                <Button Content="Vorschau abspielen"

                                        Command="{Binding PlayAnnouncementPreviewCommand}"

                                        Style="{StaticResource MaterialDesignRaisedLightButton}"

                                        Margin="0,0,0,8"

                                        ToolTip="Gong + Sequenz anhören – ohne Speichern" />

                                <Button Content="Aus Routen importieren"

                                        Command="{Binding ImportFromRoutesCommand}"

                                        Style="{StaticResource MaterialDesignOutlinedButton}"

                                        Margin="0,0,0,6" />

                                <Button Content="Aus embeddedSounds importieren"

                                        Command="{Binding ImportFromEmbeddedSoundsListCommand}"

                                        Style="{StaticResource MaterialDesignOutlinedButton}" />

                            </StackPanel>

                        </materialDesign:Card>

                    </StackPanel>

                </DockPanel>

            </ScrollViewer>

        </materialDesign:Card>

    </Grid>

</UserControl>
