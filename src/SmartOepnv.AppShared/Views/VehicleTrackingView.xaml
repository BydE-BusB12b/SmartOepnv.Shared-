<UserControl x:Class="SmartOepnv.AppShared.Views.VehicleTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             VerticalAlignment="Stretch">
    <Grid VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,8" UniformCornerRadius="12"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button Content="Jetzt aktualisieren"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,12,0" />
                    <TextBlock Text="Auto-Update: 15 s" VerticalAlignment="Center" Opacity="0.75" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           VerticalAlignment="Center" Opacity="0.85" MaxWidth="520" HorizontalAlignment="Right" />
            </DockPanel>
        </materialDesign:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <materialDesign:Card Grid.Column="0" Padding="0" UniformCornerRadius="12" Margin="0,0,8,0"
                                 Background="{StaticResource SmartSurfaceBrush}" MinHeight="480">
                <wv2:WebView2 x:Name="MapWebView" MinHeight="480" />
            </materialDesign:Card>

            <materialDesign:Card Grid.Column="1" Padding="12" UniformCornerRadius="12"
                                 Background="{StaticResource SmartPrimaryDarkBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Fahrzeugliste" Foreground="White"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Vehicles}"
                             SelectedItem="{Binding SelectedVehicle}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,6" CornerRadius="8"
                                        Background="#22000000" BorderBrush="#44FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="Bold" />
                                        <TextBlock Foreground="#BBDEFB">
                                            <Run Text="Linie/Kurs: " />
                                            <Run Text="{Binding LineCourse}" FontWeight="SemiBold" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding DetailLine}" Foreground="#E3F2FD" TextWrapping="Wrap" FontSize="12" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="#C8E6C9" FontSize="11" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding LastUpdateLabel}" Foreground="#B0BEC5" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
