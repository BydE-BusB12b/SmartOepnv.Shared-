<UserControl x:Class="SmartOepnv.AppShared.Views.SevSignEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:SmartOepnv.AppShared.Views.Controls"
             xmlns:sev="clr-namespace:SmartOepnv.AppShared.Sev"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <sev:SevAssetPathConverter x:Key="SevAssetPathConverter" />
    </UserControl.Resources>

    <Grid Margin="0,2,0,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="280" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <materialDesign:Card Grid.Column="0"
                             Margin="0,0,10,0"
                             Padding="12,10"
                             UniformCornerRadius="10"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="SEV-Schilderstellung"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,0,0,4" />
                <TextBlock DockPanel.Dock="Top"
                           Text="Linie, Ziel und Haltestellen eingeben. Betreiber-Logo unten wählen. PDF im NRW-SEV-Layout (A3 quer)."
                           Opacity="0.65"
                           FontSize="10"
                           LineHeight="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />

                <controls:EditorStatusBanner DockPanel.Dock="Bottom"
                                             Margin="0,10,0,0"
                                             Message="{Binding StatusMessage}"
                                             IsSuccess="{Binding StatusMessageIsSuccess}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Linie" Opacity="0.9" FontSize="12" Margin="0,0,0,4" />
                        <TextBox materialDesign:HintAssist.Hint="z. B. RE 10, S 28, RE 7"
                                 Text="{Binding Line, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 Padding="6,4" />

                        <TextBlock Text="Ziel" Opacity="0.9" FontSize="12" Margin="0,0,0,4" />
                        <TextBox materialDesign:HintAssist.Hint="z. B. Krefeld, Hauptbahnhof oder Expressbus, …"
                                 Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"
                                 Padding="6,4" />

                        <TextBlock Text="Aus Route übernehmen"
                                   Opacity="0.9"
                                   FontSize="12"
                                   Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Routes}"
                                  SelectedItem="{Binding SelectedRoute}"
                                  materialDesign:HintAssist.Hint="Route wählen"
                                  Margin="0,0,0,6"
                                  Padding="6,4" />
                        <CheckBox Content="Richtung umkehren (letzte Haltestelle links)"
                                  IsChecked="{Binding ImportRouteReverse}"
                                  Margin="0,0,0,6"
                                  FontSize="11" />
                        <Button Content="Haltestellen aus Route laden"
                                Command="{Binding ImportFromRouteCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,12"
                                Padding="8,4" />

                        <TextBlock Text="Haltestellen (Fahrtrichtung → Ziel)"
                                   Opacity="0.9"
                                   FontSize="12"
                                   Margin="0,0,0,6" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     materialDesign:HintAssist.Hint="Neue Haltestelle"
                                     Text="{Binding NewStopName, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"
                                     Margin="0,0,6,0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding AddStopCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Grid.Column="1"
                                    Content="+"
                                    ToolTip="Haltestelle hinzufügen"
                                    Command="{Binding AddStopCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    MinWidth="40"
                                    Padding="8,4"
                                    FontSize="16"
                                    FontWeight="Bold" />
                        </Grid>

                        <ListBox ItemsSource="{Binding Stops}"
                                 SelectedItem="{Binding SelectedStop}"
                                 MinHeight="140"
                                 MaxHeight="220"
                                 BorderThickness="1"
                                 BorderBrush="#334155"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <UniformGrid Columns="3" Margin="0,6,0,12">
                            <Button Content="Entfernen"
                                    Command="{Binding RemoveStopCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,0,4,0"
                                    Padding="6,3" />
                            <Button Content="↑"
                                    Command="{Binding MoveStopUpCommand}"
                                    ToolTip="Nach oben"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="0,0,4,0"
                                    Padding="6,3" />
                            <Button Content="↓"
                                    Command="{Binding MoveStopDownCommand}"
                                    ToolTip="Nach unten"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="6,3" />
                        </UniformGrid>

                        <TextBlock Text="Betreiber (Im Auftrag von)"
                                   Opacity="0.9"
                                   FontSize="12"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="Mehrere Betreiber möglich – Logos erscheinen nebeneinander im PDF."
                                   Opacity="0.6"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />

                        <ItemsControl ItemsSource="{Binding OperatorSelections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Margin="0,0,4,4"
                                              Padding="4">
                                        <StackPanel>
                                            <Image Source="{Binding Option.PreviewAssetFileName, Converter={StaticResource SevAssetPathConverter}}"
                                                   Height="28"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Left"
                                                   Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding Option.DisplayName}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="PDF erstellen…"
                                Command="{Binding ExportPdfCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,12,0,0"
                                Padding="10,6" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </materialDesign:Card>

        <materialDesign:Card Grid.Column="1"
                             Padding="12,10"
                             UniformCornerRadius="10"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top"
                           Text="Vorschau-Hinweise"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="11" LineHeight="15">
                        Das PDF entspricht dem NRW-SEV-Standard (A3 quer): Kopfzeile mit Linie, großes Ziel, Haltestellen entlang der Linie, unten Betreiber-Logo, VRR/mobil.nrw, zuginfo.nrw und QR-Codes.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap"
                               Opacity="0.65"
                               FontSize="10"
                               Margin="0,8,0,0"
                               FontStyle="Italic">
                        Erste Haltestelle links, letzte Haltestelle rechts (Richtung Ziel). Das Ziel erscheint zusätzlich groß oben.
                    </TextBlock>
                </StackPanel>

                <Border BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="#0F172A"
                        Padding="10">
                    <StackPanel VerticalAlignment="Center">
                        <Border Height="36" Background="#001F5B" CornerRadius="2" Margin="0,0,0,8">
                            <Grid Margin="8,4">
                                <TextBlock Text="{Binding Line}"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Ersatzverkehr mit Bussen (SEV)"
                                           Foreground="White"
                                           FontSize="9"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="160"
                                           TextAlignment="Right" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding Destination}"
                                   Foreground="#001F5B"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Stops}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#8B0045"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            Margin="2">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#8B0045"
                                                   FontSize="9" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="SEV-Logo · zuginfo.nrw · QR-Codes immer im PDF-Fuß"
                                   Opacity="0.5"
                                   FontSize="9"
                                   TextAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
