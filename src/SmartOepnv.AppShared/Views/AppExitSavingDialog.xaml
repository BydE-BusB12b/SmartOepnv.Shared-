<Window x:Class="SmartOepnv.AppShared.Views.AppExitSavingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Planer"
        Width="460"
        Height="180"
        SizeToContent="Height"
        MinWidth="400"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SmartBackgroundBrush}"
        Foreground="White"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <materialDesign:Card Margin="16"
                         Padding="28,24"
                         UniformCornerRadius="12"
                         Background="{StaticResource SmartSurfaceBrush}">
        <StackPanel>
            <TextBlock Text="Programm wird gespeichert und anschließend geschlossen."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="15"
                       FontWeight="Medium"
                       Foreground="White"
                       Margin="0,0,0,20" />
            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Foreground="{StaticResource SmartAccentBrush}" />
        </StackPanel>
    </materialDesign:Card>
</Window>
