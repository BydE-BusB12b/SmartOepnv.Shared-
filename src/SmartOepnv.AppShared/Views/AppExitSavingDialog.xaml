<Window x:Class="SmartOepnv.AppShared.Views.AppExitSavingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SmartOepnv.AppShared.Views"
        Title="Planer"
        Width="580"
        MinWidth="540"
        MinHeight="200"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FF0A1020"
        Foreground="White">

    <Border Margin="16"
            Padding="28,24"
            CornerRadius="12"
            Background="#FF121A2E">
        <StackPanel>
            <TextBlock x:Name="MessageText"
                       Text="Planer-Arbeitsstand wird lokal gespeichert, planer_workspace.json und leitstelle_stand.json nach Dropbox hochgeladen und anschließend geschlossen."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="15"
                       FontWeight="Medium"
                       Foreground="White"
                       Margin="0,0,0,20" />
            <views:PlanerSyncBusAnimation x:Name="BusAnimation" />
        </StackPanel>
    </Border>
</Window>
