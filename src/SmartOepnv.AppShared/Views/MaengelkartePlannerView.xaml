<UserControl x:Class="SmartOepnv.AppShared.Views.MaengelkartePlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="8,4,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="280" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Mängelkarte"
                   Style="{StaticResource SmartPageTitleStyle}"
                   FontSize="22"
                   Margin="0,0,0,4" />

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SmartPageSubtitleStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Text="Fahrer melden Mängel in der App (max. 60 Zeichen). Hier Status setzen: Neu → In Bearbeitung → Erledigt. Abgehakte Einträge verschwinden auf dem Tablet, bleiben in Dropbox und im Planer sichtbar." />
            <StackPanel Orientation="Horizontal">
                <Button Content="Aus Dropbox laden"
                        Command="{Binding LoadFromDropboxCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        Padding="14,4" />
                <Button Content="Aus Ordner laden"
                        Command="{Binding LoadFromLocalFolderCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"
                        Padding="14,4" />
                <Button Content="Nach Dropbox speichern"
                        Command="{Binding SaveToDropboxCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        Padding="14,4" />
                <CheckBox Content="Erledigte anzeigen"
                          IsChecked="{Binding ShowResolved}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0" />
                <TextBlock Text="Fahrzeug:"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0"
                           Opacity="0.9" />
                <ComboBox ItemsSource="{Binding VehicleFilterOptions}"
                          SelectedItem="{Binding SelectedVehicleFilter}"
                          MinWidth="200"
                          MaxWidth="320"
                          VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="In Bearbeitung"
                        Command="{Binding SetStatusInProgressCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"
                        Padding="14,4" />
                <Button Content="Als erledigt abhaken"
                        Command="{Binding SetStatusResolvedCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0"
                        Padding="14,4" />
                <Button Content="Wieder auf Neu"
                        Command="{Binding SetStatusNewCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="14,4" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Opacity="0.88"
                       FontSize="12" />
        </StackPanel>

        <materialDesign:Card Grid.Row="2"
                             Padding="0"
                             UniformCornerRadius="10"
                             Background="{StaticResource SmartSurfaceBrush}">
            <DataGrid ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      BorderThickness="0"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#18FFFFFF"
                      Margin="8"
                      MinRowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datum/Uhrzeit"
                                        Binding="{Binding CreatedDisplay}"
                                        Width="140" />
                    <DataGridTextColumn Header="Fahrer"
                                        Binding="{Binding AuthorDisplay}"
                                        Width="160" />
                    <DataGridTextColumn Header="Personalnr."
                                        Binding="{Binding AuthorPersonnel}"
                                        Width="100" />
                    <DataGridTextColumn Header="Fahrzeug"
                                        Binding="{Binding VehicleDisplay}"
                                        Width="*" MinWidth="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Mangel"
                                        Binding="{Binding Text}"
                                        Width="*" MinWidth="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding StatusLabel}"
                                        Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
