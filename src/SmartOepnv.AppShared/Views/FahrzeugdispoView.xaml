<UserControl x:Class="SmartOepnv.AppShared.Views.FahrzeugdispoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:SmartOepnv.AppShared.Views.Controls"
             xmlns:conv="clr-namespace:SmartOepnv.AppShared.Converters"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrushConverter" />
        <SolidColorBrush x:Key="DispoGridLineBrush" Color="#70FFFFFF" />
        <SolidColorBrush x:Key="DispoHeaderBgBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="DispoCellBgBrush" Color="#14000000" />
        <SolidColorBrush x:Key="DispoHourNumberBrush" Color="#FFEB3B" />
        <SolidColorBrush x:Key="DispoDayHeaderBrush" Color="#FFE082" />
        <SolidColorBrush x:Key="DispoWeekendBrush" Color="#FF8A80" />
        <Style x:Key="DispoCellButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Command"
                    Value="{Binding DataContext.ToggleDayCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="CommandParameter" Value="{Binding}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHourCell}" Value="True">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="48" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCollapseCell}" Value="True">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Command"
                            Value="{Binding DataContext.CollapseHourViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <Setter Property="CommandParameter" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpandedTarget}" Value="True">
                    <Setter Property="Background" Value="#332196F3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Fahrzeugdisposition"
                       Style="{StaticResource SmartPageTitleStyle}" />
            <TextBlock Text="Kalenderschnur: Fahrzeuge aus der Fahrzeugverwaltung, Einsätze nach Tag und Stunde."
                       Style="{StaticResource SmartPageSubtitleStyle}" />
        </StackPanel>

        <materialDesign:Card DockPanel.Dock="Top"
                             Padding="12"
                             UniformCornerRadius="12"
                             Background="{StaticResource SmartSurfaceBrush}"
                             Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Content="◀"
                        Command="{Binding PreviousWeekCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="10,4"
                        ToolTip="Vorherige Woche" />
                <Button Grid.Column="2"
                        Content="Heute"
                        Command="{Binding GoToTodayCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="12,4" />
                <Button Grid.Column="4"
                        Content="▶"
                        Command="{Binding NextWeekCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="10,4"
                        ToolTip="Nächste Woche" />

                <Button Grid.Column="6"
                        Content="Wochenansicht"
                        Command="{Binding CollapseHourViewCommand}"
                        ToolTip="Zurück zur Wochenübersicht">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                            <Setter Property="Padding" Value="12,4" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasExpandedRow}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="8"
                        Content="Neue Fahrt"
                        Command="{Binding AddTripCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="14,4"
                        ToolTip="Fahrt für ein Fahrzeug eintragen" />

                <Button Grid.Column="10"
                        Content="PDF"
                        Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="14,4"
                        ToolTip="Fahrzeugdisposition als PDF (Zeitraum, alle Fahrzeuge)" />

                <TextBlock Grid.Column="12"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           FontWeight="SemiBold">
                    <Run Text="{Binding ViewStartDate, StringFormat='{}{0:dd.MM.yyyy}', Mode=OneWay}" />
                    <Run Text=" – " />
                    <Run Text="{Binding VisibleVehicleCount, Mode=OneWay}" />
                    <Run Text=" Fahrzeuge sichtbar" />
                </TextBlock>

                <CheckBox Grid.Column="14"
                          Content="Nur aktive Fahrzeuge"
                          IsChecked="{Binding ShowOnlyActiveVehicles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center" />
            </Grid>
        </materialDesign:Card>

        <controls:EditorStatusBanner DockPanel.Dock="Bottom"
                                     Message="{Binding StatusMessage}"
                                     IsSuccess="{Binding StatusMessageIsSuccess}"
                                     Margin="0,8,0,0" />

        <materialDesign:Card Padding="0"
                             UniformCornerRadius="12"
                             Background="{StaticResource SmartSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    <!-- Kopfzeile Tage -->
                    <Grid Grid.Row="0" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                BorderBrush="{StaticResource DispoGridLineBrush}"
                                BorderThickness="0,0,1,1"
                                Background="{StaticResource DispoHeaderBgBrush}"
                                Padding="8,6">
                            <TextBlock Text="Fahrzeug"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DispoDayHeaderBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding DayHeaders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding CellWidth}"
                                            Height="34"
                                            BorderBrush="{StaticResource DispoGridLineBrush}"
                                            BorderThickness="0,0,1,1"
                                            Background="{StaticResource DispoHeaderBgBrush}"
                                            Padding="4,2">
                                        <TextBlock Text="{Binding Header}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource DispoDayHeaderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DispoWeekendBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Fahrzeugzeilen -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding VehicleRows}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            BorderBrush="{StaticResource DispoGridLineBrush}"
                                            BorderThickness="0,0,1,1"
                                            Padding="8,6"
                                            MinHeight="56"
                                            Background="{Binding RowColorHex, Converter={StaticResource HexToBrushConverter}}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="Bold"
                                                       Foreground="#C62828"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="10"
                                                       Opacity="0.8"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Subtitle}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding HourModeDateLabel, StringFormat='Stunden: {0}'}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Margin="0,4,0,0"
                                                       Opacity="0.9">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHourMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Column="1" MinHeight="56">
                                        <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource DispoGridLineBrush}"
                                                        BorderThickness="0,0,1,1"
                                                        Background="{StaticResource DispoCellBgBrush}"
                                                        Width="{Binding CellWidth}"
                                                        MinHeight="56">
                                                    <Button Style="{StaticResource DispoCellButtonStyle}"
                                                            ToolTip="{Binding Tooltip}">
                                                        <Grid>
                                                            <!-- Zurück (Stundenansicht) -->
                                                            <TextBlock Text="◀"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource DispoHourNumberBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCollapseCell}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <!-- Stunde -->
                                                            <TextBlock Text="{Binding Header}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Bottom"
                                                                       Margin="0,0,0,2"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource DispoHourNumberBrush}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsHourCell}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl x:Name="AssignmentBarsHost"
                                                      ItemsSource="{Binding AssignmentBars}"
                                                      IsHitTestVisible="True"
                                                      Panel.ZIndex="1"
                                                      VerticalAlignment="Center"
                                                      Height="56">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas Height="56" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                    <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                                    <Setter Property="Panel.ZIndex" Value="{Binding LaneIndex}" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="{Binding Width}"
                                                          Height="{Binding Height}"
                                                          Cursor="Hand"
                                                          ToolTip="{Binding Tooltip}"
                                                          MouseLeftButtonUp="AssignmentBar_MouseLeftButtonUp"
                                                          MouseRightButtonUp="AssignmentBar_MouseRightButtonUp">
                                                        <!-- Tagesansicht -->
                                                        <Border Background="#CC5C6BC0"
                                                                BorderBrush="#FF7986CB"
                                                                BorderThickness="1"
                                                                CornerRadius="3">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHourViewBar}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="8"
                                                                       Foreground="White"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"
                                                                       Margin="4,0"
                                                                       TextWrapping="NoWrap" />
                                                        </Border>

                                                        <!-- Stundenansicht: dicker Neongrün-Balken mit Bezeichnung + Uhrzeit -->
                                                        <Border CornerRadius="4" Padding="4,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Setter Property="Background" Value="#CC39FF14" />
                                                                    <Setter Property="BorderBrush" Value="#FF76FF03" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsHourViewBar}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                                                                <TextBlock Text="{Binding Label}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="#0A1628"
                                                                           TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Label}" Value="">
                                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding TimeLabel}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#0A1628"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,1,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
            </Grid>
        </materialDesign:Card>
    </DockPanel>
</UserControl>
