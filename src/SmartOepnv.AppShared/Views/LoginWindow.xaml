<Window x:Class="SmartOepnv.AppShared.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Smart-ÖPNV Planer – Anmeldung"
        Height="500" Width="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="{StaticResource SmartBackgroundBrush}"
        Foreground="White"
        TextElement.Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Anmeldung"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Margin="0,0,0,6" />
            <TextBlock Text="Hauptnutzer mit Vor- und Nachname anmelden. Beim ersten Start zuerst Dropbox einrichten."
                       TextWrapping="Wrap"
                       Foreground="White"
                       Opacity="0.78"
                       FontSize="12" />
            <TextBlock x:Name="LockWarningText"
                       TextWrapping="Wrap"
                       Foreground="#FFCC80"
                       FontSize="12"
                       Margin="0,8,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Benutzername"
                       Margin="0,0,0,4"
                       Foreground="White"
                       Opacity="0.9" />
            <TextBox x:Name="UsernameBox"
                     Margin="0,0,0,12"
                     Padding="8,6"
                     Foreground="White"
                     CaretBrush="White"
                     materialDesign:HintAssist.Hint="z. B. Max Mustermann"
                     materialDesign:HintAssist.Foreground="#CCFFFFFF"
                     materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource SmartAccentBrush}" />

            <TextBlock Text="Passwort"
                       Margin="0,0,0,4"
                       Foreground="White"
                       Opacity="0.9" />
            <PasswordBox x:Name="PasswordBox"
                         Margin="0,0,0,8"
                         Padding="8,6"
                         Foreground="White"
                         CaretBrush="White"
                         materialDesign:HintAssist.Hint="Passwort"
                         materialDesign:HintAssist.Foreground="#CCFFFFFF"
                         materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource SmartAccentBrush}"
                         KeyDown="PasswordBox_OnKeyDown" />

            <TextBlock x:Name="ErrorText"
                       Foreground="#FF8A80"
                       TextWrapping="Wrap"
                       MinHeight="20"
                       Margin="0,4,0,0"
                       FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="ForceReleaseLockButton"
                    Content="Sperre freigeben (Hauptnutzer)…"
                    HorizontalAlignment="Left"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="16,6"
                    Margin="0,0,0,8"
                    Visibility="Collapsed"
                    Click="ForceReleaseLock_Click" />
            <Button Content="Dropbox einrichten…"
                    HorizontalAlignment="Left"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="16,6"
                    Margin="0,0,0,12"
                    Click="SetupDropbox_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="16,6"
                        Click="Cancel_Click" />
                <Button x:Name="LoginButton"
                        Content="Anmelden"
                        IsDefault="True"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="16,6"
                        Click="Login_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
