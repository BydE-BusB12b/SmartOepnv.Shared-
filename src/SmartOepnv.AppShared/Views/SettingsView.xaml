<UserControl x:Class="SmartOepnv.AppShared.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartOepnv.AppShared.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:FilePathToImageConverter x:Key="FilePathToImageConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="820">
            <TextBlock Text="Einstellungen" Style="{StaticResource SmartPageTitleStyle}" />
            <TextBlock Style="{StaticResource SmartPageSubtitleStyle}"
                       Text="Dropbox-Verbindung, Firmenlogos und Ordnerpfad – kompatibel zur GPSAnsagen-App (routes_export.json)." />

            <materialDesign:Card Padding="24"
                                 UniformCornerRadius="12"
                                 Background="{StaticResource SmartSurfaceBrush}"
                                 Margin="0,0,0,16"
                                 Visibility="{Binding ShowBrandingSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Firmenlogos" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="Mehrere Logos speichern und in Dienstvorlagen je PDF auswählen. Ersetzt das Feld „Auftraggeber“ in der PDF-Kopfzeile." />

                    <ListBox ItemsSource="{Binding CompanyLogos}"
                             SelectedItem="{Binding SelectedCompanyLogo}"
                             MinHeight="72"
                             MaxHeight="140"
                             Margin="0,0,0,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Background="{StaticResource SmartPrimaryDarkBrush}"
                            CornerRadius="8"
                            Padding="16"
                            MinHeight="96"
                            Margin="0,0,0,12"
                            Visibility="{Binding HasCompanyLogos, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image Source="{Binding SelectedCompanyLogo.FilePath, Converter={StaticResource FilePathToImageConverter}}"
                               Stretch="Uniform"
                               MaxHeight="72"
                               HorizontalAlignment="Left" />
                    </Border>

                    <TextBox materialDesign:HintAssist.Hint="Bezeichnung des ausgewählten Logos"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SelectedCompanyLogo.Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8"
                             Visibility="{Binding HasCompanyLogos, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock Text="{Binding BrandingStatus}" Opacity="0.85" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Logo hinzufügen…"
                                Command="{Binding ChooseCompanyLogoCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Logo entfernen"
                                Command="{Binding RemoveSelectedCompanyLogoCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasCompanyLogos, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Bezeichnung speichern"
                                Command="{Binding SaveSelectedLogoNameCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Visibility="{Binding HasCompanyLogos, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="24"
                                 UniformCornerRadius="12"
                                 Background="{StaticResource SmartSurfaceBrush}"
                                 Margin="0,0,0,16"
                                 Visibility="{Binding ShowBrandingSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Einweisungs-PDF – Fahrgeräte" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="Geräte- und Entsperrpasswort für alle Einweisungs-PDFs in der Personalverwaltung. Das persönliche Bus-Passwort pro Fahrer bleibt im Mitarbeiterdatensatz." />
                    <TextBox materialDesign:HintAssist.Hint="Gerätepasswort"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding DevicePassword, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />
                    <TextBox materialDesign:HintAssist.Hint="Entsperrpasswort"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding UnlockPassword, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,8" />
                    <TextBlock Text="{Binding BriefingPasswordsStatus}" Opacity="0.85" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <Button Content="Passwörter speichern"
                            Command="{Binding SaveBriefingPasswordsCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="24"
                                 UniformCornerRadius="12"
                                 Background="{StaticResource SmartSurfaceBrush}"
                                 Margin="0,0,0,16"
                                 Visibility="{Binding ShowBrandingSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Ansagen – Sondergong" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="Tondatei für die Checkbox „Sondergong“ unter Ansagen → Ton &amp; Import. Wird vor die Zusammenfüge-Sequenz gesetzt (nach dem normalen Gong, falls aktiv)." />
                    <TextBlock Text="{Binding SondergongFileLabel}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding SondergongStatus}" Opacity="0.85" Margin="0,0,0,12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Sondergong wählen…"
                                Command="{Binding ChooseSondergongSoundCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Entfernen"
                                Command="{Binding ClearSondergongSoundCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="24" UniformCornerRadius="12" Background="{StaticResource SmartSurfaceBrush}" Margin="0,0,0,16"
                                 Visibility="{Binding ShowVoipSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Funk / VoIP" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="Smart ÖPNV Funk – Server-Einstellungen und Konfiguration für Tablets (Dropbox)." />
                    <TextBlock Text="{Binding VoipStatusMessage}" Opacity="0.85" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="VoIP-Einstellungen"
                                Command="{Binding OpenVoipSettingsCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="VoIP-Config nach Dropbox"
                                Command="{Binding PublishVoipConfigCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                    <TextBlock Text="{Binding VoipPublishStatus}" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="24" UniformCornerRadius="12" Background="{StaticResource SmartSurfaceBrush}" Margin="0,0,0,16"
                                 Visibility="{Binding ShowPlannerManualExport, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Unterweisungsanleitung Planer" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="Vollständige PDF-Anleitung für alle Planer-Bereiche (Routen, Disposition, Versand, …). Screenshots unter Assets/briefing/planner/ – siehe PLANER_LEITSTELLE_SCREENSHOT_GUIDE.md." />
                    <Button Content="Planer-Anleitung als PDF erstellen"
                            Command="{Binding ExportPlannerOperatorManualPdfCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <TextBlock Text="{Binding OperatorManualExportStatus}" Opacity="0.85" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="24" UniformCornerRadius="12" Background="{StaticResource SmartSurfaceBrush}" Margin="0,0,0,16"
                                 Visibility="{Binding ShowLeitstelleManualExport, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Unterweisungsanleitung Leitstelle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="Vollständige PDF-Anleitung für Live-Karte, Fernsteuerung, Funk, Nachrichten und Versand. Screenshots unter Assets/briefing/leitstelle/." />
                    <Button Content="Leitstelle-Anleitung als PDF erstellen"
                            Command="{Binding ExportLeitstelleOperatorManualPdfCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <TextBlock Text="{Binding OperatorManualExportStatus}" Opacity="0.85" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="24" UniformCornerRadius="12" Background="{StaticResource SmartSurfaceBrush}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Dropbox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold"
                               Foreground="{StaticResource SmartAccentBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding AccountInfo}" Opacity="0.85" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Mit Dropbox verbinden"
                                Command="{Binding ConnectDropboxCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Trennen"
                                Command="{Binding DisconnectDropboxCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Verbindung testen"
                                Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="24" UniformCornerRadius="12" Background="{StaticResource SmartSurfaceBrush}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Dropbox-Ordner" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="Standard: /smart öpnv – bei geteiltem Ordner ggf. abweichenden Pfad eintragen (wie in der Android-App). Der Pfad wird beim Verbindungstest, beim Verlassen der Seite und in „Dropbox einrichten“ beim Schließen automatisch gespeichert." />
                    <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Ordnerpfad"
                             Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Ordnerpfad speichern"
                                Command="{Binding SaveFolderPathCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Betrieb wechseln"
                                Command="{Binding SwitchBetriebCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Visibility="{Binding ShowBetriebSwitch, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Opacity="0.85" TextWrapping="Wrap"
                               Visibility="{Binding ShowBetriebSwitch, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text="Aktiver Betrieb: " FontWeight="SemiBold" />
                        <Run Text="{Binding ActiveBetriebLabel}" />
                    </TextBlock>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="24" UniformCornerRadius="12" Background="{StaticResource SmartSurfaceBrush}" Margin="0,0,0,16"
                                 Visibility="{Binding ShowPlanerFolderSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Planer-Ordner (Dropbox)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                               Text="Anmeldung nur möglich, wenn im Ordner planer_workspace.json oder planer_session.json liegt. Bei neuer Installation einmalig initialisieren – danach nutzen alle Planer denselben Ordner." />
                    <Button Content="Planer-Ordner initialisieren"
                            Command="{Binding InitializePlanerFolderCommand}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Margin="0,0,0,8" />
                    <TextBlock Text="{Binding PlanerFolderInfo}" Opacity="0.85" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="24" UniformCornerRadius="12" Background="{StaticResource SmartPrimaryDarkBrush}">
                <StackPanel>
                    <TextBlock Text="Verbindungstest" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding TestResult}" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding RouteFileInfo}" Foreground="White" Opacity="0.9" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding PlanerFolderInfo}"
                               Foreground="White"
                               Opacity="0.9"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"
                               Visibility="{Binding ShowPlanerFolderSection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding FolderFilesSummary}" Foreground="White" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>
    </StackPanel>
    </ScrollViewer>
</UserControl>
