                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Dienstvorlage erstellen (Teil 2)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Background="#1A2744"
                            BorderBrush="#334B7A"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,8"
                            Visibility="{Binding IsThreePartDuty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Teil 3 – Kennzahlen"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="{StaticResource SmartAccentBrush}"
                                       Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource DutyStatCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Dienstlänge" Opacity="0.75" FontSize="10" />
                                        <TextBlock Text="{Binding Part3ServiceDurationDisplay}" FontWeight="Bold" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource SmartAccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Part3ExceedsMaxDuration}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFE53935" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource DutyStatCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Lohnstunden" Opacity="0.75" FontSize="10" />
                                        <TextBlock Text="{Binding Part3PayHoursDisplay}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SmartAccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource DutyStatCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Pausen" Opacity="0.75" FontSize="10" />
                                        <TextBlock Text="{Binding Part3BreaksDisplay}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SmartAccentBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource DutyStatCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Reine Lenkzeit" Opacity="0.75" FontSize="10" />
                                        <TextBlock Text="{Binding Part3PureDrivingDisplay}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SmartAccentBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource DutyStatCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Reine Pausenzeit" Opacity="0.75" FontSize="10" />
                                        <TextBlock Text="{Binding Part3PureBreakDisplay}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource SmartAccentBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <CheckBox Content="30 Min. unbezahlte Pause abziehen (Teil 3)"
                                      IsChecked="{Binding SubtractUnpaidBreak30MinutesPart3}"
                                      Margin="0,0,0,4"
                                      Foreground="White"
                                      FontSize="11" />
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="Part3RowsGrid"
                              ItemsSource="{Binding Part3Rows}"
                              SelectedItem="{Binding SelectedPart3Row}"
                              GotFocus="Part3RowsGrid_GotFocus"
                              SelectionChanged="Part3RowsGrid_SelectionChanged"
                              Style="{StaticResource DutyDataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              SelectionMode="Extended"
                              IsReadOnly="False"
                              Margin="0,0,0,10"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              MaxHeight="420"
                              RowStyle="{StaticResource DutyDataGridRowStyle}"
                              Visibility="{Binding IsThreePartDuty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource SmartPrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="BorderBrush" Value="{StaticResource SmartPrimaryDarkBrush}" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fahrtnr." Binding="{Binding TripNumber, UpdateSourceTrigger=PropertyChanged}" Width="0.75*" />
                            <DataGridTextColumn Header="Linie/Kurs" Binding="{Binding LineCourse, UpdateSourceTrigger=PropertyChanged}" Width="0.85*" />
                            <DataGridTextColumn Header="Bemerkung" Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                            <DataGridTextColumn Header="Ziel" Binding="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" Width="0.9*" />
                            <DataGridTextColumn Header="ab Zeit" Binding="{Binding FromTime, UpdateSourceTrigger=PropertyChanged}" Width="0.65*" />
                            <DataGridTextColumn Header="ab Haltestelle" Binding="{Binding FromStop, UpdateSourceTrigger=PropertyChanged}" Width="1.3*" />
                            <DataGridTextColumn Header="an Zeit" Binding="{Binding ToTime, UpdateSourceTrigger=PropertyChanged}" Width="0.65*" />
                            <DataGridTextColumn Header="an Haltestelle" Binding="{Binding ToStop, UpdateSourceTrigger=PropertyChanged}" Width="1.3*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Right"
                                Margin="0,0,0,10"
                                Visibility="{Binding IsThreePartDuty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Command="{Binding ExportPart3PdfCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource SmartPrimaryDarkBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Dienstvorlage erstellen (Teil 3)" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Padding="12,10"
                            Background="#1A5472D3"
                            CornerRadius="8"
                            Visibility="{Binding HasRemarkLegend, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Bemerkungen"
                                       Style="{StaticResource DutySectionTitleStyle}"
                                       Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding RemarkLegend}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2,0,0">
                                            <Run Text="{Binding Code}"
                                                 FontWeight="SemiBold"
                                                 Foreground="{StaticResource SmartPrimaryLightBrush}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding Text}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
