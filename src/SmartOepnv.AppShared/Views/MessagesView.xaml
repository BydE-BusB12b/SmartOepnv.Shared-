<UserControl x:Class="SmartOepnv.AppShared.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Nachrichten"
                           FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4" />
                <TextBlock Text="messageTemplates (KOM) und mailTemplates – wie in der Android-App, werden mit routes_export.json verteilt."
                           Opacity="0.65" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Padding="16" UniformCornerRadius="12"
                                     Background="{StaticResource SmartSurfaceBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="KOM-Nachrichtenvorlagen"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBox Text="{Binding NewMessageTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Neue Vorlage…"
                                     Margin="0,0,0,8" />
                            <Button Content="Hinzufügen"
                                    Command="{Binding AddMessageTemplateCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,0,8" />
                            <Button Content="Auswahl löschen"
                                    Command="{Binding RemoveMessageTemplateCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding MessageTemplates}"
                                 SelectedItem="{Binding SelectedMessageTemplate}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MinHeight="200" />
                    </DockPanel>
                </materialDesign:Card>

                <materialDesign:Card Grid.Column="2" Padding="16" UniformCornerRadius="12"
                                     Background="{StaticResource SmartSurfaceBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Mail-Vorlagen"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBox Text="{Binding NewMailTemplate, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Neue Mail-Vorlage…"
                                     Margin="0,0,0,8" />
                            <Button Content="Hinzufügen"
                                    Command="{Binding AddMailTemplateCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,0,8" />
                            <Button Content="Auswahl löschen"
                                    Command="{Binding RemoveMailTemplateCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                        <ListBox ItemsSource="{Binding MailTemplates}"
                                 SelectedItem="{Binding SelectedMailTemplate}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MinHeight="200" />
                    </DockPanel>
                </materialDesign:Card>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Button Content="Speichern"
                        Command="{Binding SaveChangesCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Left"
                        MinWidth="160"
                        Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap" Opacity="0.85" FontSize="12" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
