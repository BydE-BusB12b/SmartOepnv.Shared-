<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartOepnv.Fahrgeraet.MainWindow"
        Title="Smart ÖPNV"
        Width="1280"
        Height="800"
        WindowState="Maximized"
        Background="#2196F3">
  <Grid ColumnDefinitions="280,*" Margin="12">
    <StackPanel x:Name="Nav" Spacing="6" />
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border x:Name="IbisChip" CornerRadius="6" Padding="10,4" Background="#C62828">
          <TextBlock x:Name="IbisChipText" Text="IBIS-IP" Foreground="White" FontSize="16" />
        </Border>
        <TextBlock x:Name="StatusText" Foreground="White" FontSize="16" TextWrapping="Wrap" />
      </StackPanel>
      <ContentControl x:Name="PageHost" Grid.Row="1" />
    </Grid>
  </Grid>
</Window>
